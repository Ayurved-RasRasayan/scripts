//@version=6
indicator('(13) Up finale', '(12) Up finale', overlay=true, max_labels_count=500, max_lines_count=500, max_boxes_count=1000, calc_bars_count=500)

// ═══════════════════════════════════════════════════════════════════════════════
// MASTER VISIBILITY CONTROLS
// ═══════════════════════════════════════════════════════════════════════════════
GRP_VIS = '═══════════ Master Visibility ═══════════'

show_ma       = input.bool(true, '👁 01. Moving Averages',      group=GRP_VIS)
show_rsi_trend= input.bool(true, '👁 02. RSI Trend Slow',       group=GRP_VIS)
show_smc      = input.bool(true, '👁 03. Smart Money Concept',   group=GRP_VIS)
show_mtf      = input.bool(true, '👁 04. MTF Table',             group=GRP_VIS)
show_ncp      = input.bool(true, '👁 05. Next Candle Predictor', group=GRP_VIS)
show_gflip    = input.bool(false, '👁 06. Gold Flip',             group=GRP_VIS)
show_wt       = input.bool(true, '👁 07. WaveTrend',             group=GRP_VIS)
show_session  = input.bool(true, '👁 08. Session Box',           group=GRP_VIS)
show_lsp      = input.bool(true, '👁 09. Liquidity Sentiment Profile', group=GRP_VIS)

// ═══════════════════════════════════════════════════════════════════════════════
// SHARED CALCULATIONS
// ═══════════════════════════════════════════════════════════════════════════════
// Shared ATR — used by RSI Trend, SMC, NCP; skip when none need it
atr_shared     = show_rsi_trend or show_smc or show_ncp ? ta.atr(14)  : na
atr_shared_200 = show_smc                                     ? ta.atr(200) : na

// ── LSP: max_bars_back for dynamic bar indexing ──
max_bars_back(high,   5000)
max_bars_back(low,    5000)
max_bars_back(close,  5000)
max_bars_back(open,   5000)
max_bars_back(volume, 5000)

// ═══════════════════════════════════════════════════════════════════════════════
// 01. MOVING AVERAGES
// ═══════════════════════════════════════════════════════════════════════════════
g_ma = '═══════════ 01. Moving Averages ═══════════'

s1 = input.bool(true,  'Show', inline='1', group=g_ma)
p1 = input.int(10,     'MA 1', inline='1', minval=1, group=g_ma)
t1 = input.string('SMA', '',   inline='1', options=['SMA','EMA','WMA','VWMA','RMA','HMA','ALMA','LSMA','SWMA'], group=g_ma)
c1 = input.color(color.rgb(0,177,0), '', inline='1', group=g_ma)
w1 = input.int(1,      '',     inline='1', minval=1, maxval=4, group=g_ma)

s2 = input.bool(true,  'Show', inline='2', group=g_ma)
p2 = input.int(20,     'MA 2', inline='2', minval=1, group=g_ma)
t2 = input.string('SMA', '',   inline='2', options=['SMA','EMA','WMA','VWMA','RMA','HMA','ALMA','LSMA','SWMA'], group=g_ma)
c2 = input.color(color.rgb(255,7,7), '', inline='2', group=g_ma)
w2 = input.int(1,      '',     inline='2', minval=1, maxval=4, group=g_ma)

s3 = input.bool(true,  'Show', inline='3', group=g_ma)
p3 = input.int(200,    'MA 3', inline='3', minval=1, group=g_ma)
t3 = input.string('SMA', '',   inline='3', options=['SMA','EMA','WMA','VWMA','RMA','HMA','ALMA','LSMA','SWMA'], group=g_ma)
c3 = input.color(#161616, '',  inline='3', group=g_ma)
w3 = input.int(2,      '',     inline='3', minval=1, maxval=4, group=g_ma)

f_ma(src, len, type) =>
    switch type
        'EMA'  => ta.ema(src, len)
        'WMA'  => ta.wma(src, len)
        'VWMA' => ta.vwma(src, len)
        'RMA'  => ta.rma(src, len)
        'HMA'  => ta.hma(src, len)
        'ALMA' => ta.alma(src, len, 0.85, 6)
        'LSMA' => ta.linreg(src, len, 0)
        'SWMA' => ta.swma(src)
        =>        ta.sma(src, len)

m1 = show_ma ? f_ma(close, p1, t1) : na
m2 = show_ma ? f_ma(close, p2, t2) : na
m3 = show_ma ? f_ma(close, p3, t3) : na

plot(show_ma and s1 ? m1 : na, 'MA1', c1, math.max(1, w1))
plot(show_ma and s2 ? m2 : na, 'MA2', c2, math.max(1, w2))
plot(show_ma and s3 ? m3 : na, 'MA3', c3, math.max(1, w3))

// ═══════════════════════════════════════════════════════════════════════════════
// 02. RSI TREND SLOW
// ═══════════════════════════════════════════════════════════════════════════════
groupRSI_Slow         = '═══════════ 02. RSI Trend Slow ═══════════'

rsiPeriod_hois        = input.int(14,   'RSI Period',       minval=2,   group=groupRSI_Slow)
rsiSmoothing_hois     = input.int(2,    'RSI Smoothing',    minval=1,   group=groupRSI_Slow)
trendPeriod_hois      = input.int(21,   'Base Trend Period', minval=2,  group=groupRSI_Slow)
rsiSensitivity_hois   = input.float(0.5,'RSI Sensitivity',  step=0.1, minval=0.1, maxval=2.0, group=groupRSI_Slow)
atrPeriod_hois        = input.int(14,   'ATR Period',       minval=1,   group=groupRSI_Slow)
atrMultiplier_hois    = input.float(1.5,'ATR Multiplier',   step=0.1, minval=0.1, group=groupRSI_Slow)
lineStyle_hois        = input.string('Solid','Line Style',  options=['Solid','Circles','Dotted','Dashed'], group=groupRSI_Slow)
lineWidth_hois        = input.int(4,    'Line Width',       minval=1, maxval=10, group=groupRSI_Slow)
showRSITrend_hois     = input.bool(true,'Show RSI Trend Line', group=groupRSI_Slow)
color_preset_hois     = input.string('Custom','Color Preset', options=['Classic','Aqua','Cosmic','Custom'], group=groupRSI_Slow)
bullColor_hois        = input.color(color.rgb(7,245,58),  'Bullish Color', group=groupRSI_Slow)
bearColor_hois        = input.color(color.rgb(255,0,13),  'Bearish Color', group=groupRSI_Slow)

[final_bullish_color_hois, final_bearish_color_hois] = switch color_preset_hois
    'Classic' => [#00ff00, #ff0000]
    'Aqua'    => [#00bfff, #ff8c00]
    'Cosmic'  => [#ff1493, #9932cc]
    'Custom'  => [bullColor_hois, bearColor_hois]

plotStyle_hois = switch lineStyle_hois
    'Solid'  => plot.style_line
    'Circles'=> plot.style_circles
    'Dotted' => plot.style_circles
    'Dashed' => plot.style_stepline
    =>          plot.style_line

// ── RSI Trend function (must stay at global scope for Pine) ──────────────
rsiSmoothedTrend_hois(source, rsiLen, rsiSmooth, trendLen, sensitivity) =>
    rsiValue      = ta.rsi(source, rsiLen)
    smoothedRSI   = ta.ema(rsiValue, rsiSmooth)
    normalizedRSI = (smoothedRSI - 50) / 50
    rsiAdjustment = normalizedRSI * nz(atr_shared, ta.atr(14)) * sensitivity
    adaptiveAlpha = smoothedRSI > 50 ? 2.0 / (trendLen * 0.5 + 1) : 2.0 / (trendLen * 1.5 + 1)
    var float adaptiveTrend = source
    adaptiveTrend := adaptiveAlpha * source + (1 - adaptiveAlpha) * nz(adaptiveTrend[1], source)
    adaptiveTrend + rsiAdjustment

var float rsiTrendValue_hois = na
var float trendLine_hois     = na
var bool  isBullish_hois     = false
var bool  isBearish_hois     = false

if show_rsi_trend
    rsiTrendValue_hois := rsiSmoothedTrend_hois(close, rsiPeriod_hois, rsiSmoothing_hois, trendPeriod_hois, rsiSensitivity_hois)

    atr_hois       = atrPeriod_hois == 14 ? atr_shared : ta.atr(atrPeriod_hois)
    deviation_hois = atr_hois * atrMultiplier_hois
    upperBound_hois = rsiTrendValue_hois + deviation_hois
    lowerBound_hois = rsiTrendValue_hois - deviation_hois

    trendLine_hois := na(trendLine_hois) ? rsiTrendValue_hois : trendLine_hois
    if upperBound_hois < trendLine_hois
        trendLine_hois := upperBound_hois
    if lowerBound_hois > trendLine_hois
        trendLine_hois := lowerBound_hois

    trendUp_hois   = trendLine_hois > trendLine_hois[1]
    trendDown_hois = trendLine_hois < trendLine_hois[1]

    if trendUp_hois
        isBullish_hois := true
        isBearish_hois := false
    else if trendDown_hois
        isBullish_hois := false
        isBearish_hois := true

currentTrend_hois = isBullish_hois ? final_bullish_color_hois : final_bearish_color_hois
plot(show_rsi_trend and showRSITrend_hois ? trendLine_hois : na, 'RSI Trend Line', color=currentTrend_hois, linewidth=lineWidth_hois, style=plotStyle_hois)

alertcondition(show_rsi_trend and isBullish_hois and not isBullish_hois[1], title='RSI Trend Bullish', message='RSI Trend Bullish Signal {{exchange}}:{{ticker}}')
alertcondition(show_rsi_trend and isBearish_hois and not isBearish_hois[1], title='RSI Trend Bearish', message='RSI Trend Bearish Signal {{exchange}}:{{ticker}}')

// ═══════════════════════════════════════════════════════════════════════════════
// 03. SMART MONEY CONCEPT (SMC)
// ═══════════════════════════════════════════════════════════════════════════════
BULLISH_LEG = 1
BEARISH_LEG = 0
BULLISH = +1
BEARISH = -1
GREEN = #089981
RED   = #F23645
BLUE  = #2157f3
GRAY  = #878b94
MONO_BULLISH = #b2b5be
MONO_BEARISH = #5d606b
HISTORICAL   = 'Historical'
PRESENT      = 'Present'
COLORED      = 'Colored'
MONOCHROME   = 'Monochrome'
ALL   = 'All'
BOS   = 'BOS'
CHOCH = 'CHoCH'
TINY  = size.tiny
SMALL = size.small
NORMAL = size.normal
ATR   = 'Atr'
RANGE = 'Cumulative Mean Range'
CLOSE   = 'Close'
HIGHLOW = 'High/Low'
SOLID  = '⎯⎯⎯'
DASHED = '----'
DOTTED = '····'

SMART_GROUP   = '═══════════ 03. SMC - General Settings ═══════════'
INTERNAL_GROUP = '03. SMC - Internal Structure'
SWING_GROUP    = '03. SMC - Swing Structure'
BLOCKS_GROUP   = '03. SMC - Order Blocks'
EQUAL_GROUP    = '03. SMC - Equal Highs/Lows'
GAPS_GROUP     = '03. SMC - Fair Value Gaps'
LEVELS_GROUP   = '03. SMC - Levels (D/W/M)'
ZONES_GROUP    = '03. SMC - Premium/Discount'

modeInput  = input.string(HISTORICAL, 'Mode',  group=SMART_GROUP, options=[HISTORICAL, PRESENT])
styleInput = input.string(COLORED,    'Style', group=SMART_GROUP, options=[COLORED, MONOCHROME])
showTrendInput = input(false, 'Color Candles', group=SMART_GROUP)

showInternalsInput           = input(true,    'Show Internal Structure',    group=INTERNAL_GROUP)
showInternalBullInput        = input.string(ALL, 'Bullish Structure',       group=INTERNAL_GROUP, inline='ibull', options=[ALL, BOS, CHOCH])
internalBullColorInput       = input(GREEN,   '',                           group=INTERNAL_GROUP, inline='ibull')
showInternalBearInput        = input.string(ALL, 'Bearish Structure',       group=INTERNAL_GROUP, inline='ibear', options=[ALL, BOS, CHOCH])
internalBearColorInput       = input(RED,     '',                           group=INTERNAL_GROUP, inline='ibear')
internalFilterConfluenceInput= input(false,   'Confluence Filter',          group=INTERNAL_GROUP)
internalStructureSize        = input.string(TINY, 'Internal Label Size',   group=INTERNAL_GROUP, options=[TINY, SMALL, NORMAL])

showStructureInput    = input(true,  'Show Swing Structure',         group=SWING_GROUP)
showSwingBullInput    = input.string(ALL, 'Bullish Structure',       group=SWING_GROUP, inline='bull', options=[ALL, BOS, CHOCH])
swingBullColorInput   = input(GREEN, '',                             group=SWING_GROUP, inline='bull')
showSwingBearInput    = input.string(ALL, 'Bearish Structure',       group=SWING_GROUP, inline='bear', options=[ALL, BOS, CHOCH])
swingBearColorInput   = input(RED,   '',                             group=SWING_GROUP, inline='bear')
swingStructureSize    = input.string(SMALL, 'Swing Label Size',     group=SWING_GROUP, options=[TINY, SMALL, NORMAL])
showSwingsInput       = input(false, 'Show Swings Points',           group=SWING_GROUP, inline='swings')
swingsLengthInput     = input.int(50, '',                            group=SWING_GROUP, minval=10, inline='swings')
showHighLowSwingsInput= input(true,  'Show Strong/Weak High/Low',   group=SWING_GROUP)

showInternalOrderBlocksInput  = input(true,  'Internal Order Blocks', group=BLOCKS_GROUP, inline='iob')
internalOrderBlocksSizeInput  = input.int(5, '',                      group=BLOCKS_GROUP, minval=1, maxval=20, inline='iob')
showSwingOrderBlocksInput     = input(false, 'Swing Order Blocks',    group=BLOCKS_GROUP, inline='ob')
swingOrderBlocksSizeInput     = input.int(5, '',                      group=BLOCKS_GROUP, minval=1, maxval=20, inline='ob')
orderBlockFilterInput         = input.string('Atr', 'Order Block Filter',      group=BLOCKS_GROUP, options=[ATR, RANGE])
orderBlockMitigationInput     = input.string(HIGHLOW, 'Order Block Mitigation', group=BLOCKS_GROUP, options=[CLOSE, HIGHLOW])
internalBullishOrderBlockColor= input.color(color.new(#3179f5,80), 'Internal Bullish OB', group=BLOCKS_GROUP)
internalBearishOrderBlockColor= input.color(color.new(#f77c80,80), 'Internal Bearish OB', group=BLOCKS_GROUP)
swingBullishOrderBlockColor   = input.color(color.new(#1848cc,80), 'Bullish OB',          group=BLOCKS_GROUP)
swingBearishOrderBlockColor   = input.color(color.new(#b22833,80), 'Bearish OB',          group=BLOCKS_GROUP)

showEqualHighsLowsInput       = input(false,  'Equal High/Low',      group=EQUAL_GROUP)
equalHighsLowsLengthInput     = input.int(3,  'Bars Confirmation',   group=EQUAL_GROUP, minval=1)
equalHighsLowsThresholdInput  = input.float(0.1,'Threshold',         group=EQUAL_GROUP, minval=0, maxval=0.5, step=0.1)
equalHighsLowsSizeInput       = input.string(TINY, 'Label Size',     group=EQUAL_GROUP, options=[TINY, SMALL, NORMAL])

showFairValueGapsInput        = input(false,  'Fair Value Gaps',     group=GAPS_GROUP)
fairValueGapsThresholdInput   = input(true,   'Auto Threshold',      group=GAPS_GROUP)
fairValueGapsTimeframeInput   = input.timeframe('', 'Timeframe',     group=GAPS_GROUP)
fairValueGapsBullColorInput   = input.color(color.new(#00ff68,70), 'Bullish FVG', group=GAPS_GROUP)
fairValueGapsBearColorInput   = input.color(color.new(#ff0008,70), 'Bearish FVG', group=GAPS_GROUP)
fairValueGapsExtendInput      = input.int(1,  'Extend FVG',         group=GAPS_GROUP, minval=0)

showDailyLevelsInput    = input(true,  'Daily',   group=LEVELS_GROUP, inline='daily')
dailyLevelsStyleInput   = input.string(SOLID,'',  group=LEVELS_GROUP, inline='daily',   options=[SOLID,DASHED,DOTTED])
dailyLevelsColorInput   = input(BLUE,  '',         group=LEVELS_GROUP, inline='daily')
showWeeklyLevelsInput   = input(false, 'Weekly',  group=LEVELS_GROUP, inline='weekly')
weeklyLevelsStyleInput  = input.string(SOLID,'',  group=LEVELS_GROUP, inline='weekly',  options=[SOLID,DASHED,DOTTED])
weeklyLevelsColorInput  = input(BLUE,  '',         group=LEVELS_GROUP, inline='weekly')
showMonthlyLevelsInput  = input(false, 'Monthly', group=LEVELS_GROUP, inline='monthly')
monthlyLevelsStyleInput = input.string(SOLID,'',  group=LEVELS_GROUP, inline='monthly', options=[SOLID,DASHED,DOTTED])
monthlyLevelsColorInput = input(BLUE,  '',         group=LEVELS_GROUP, inline='monthly')

showPremiumDiscountZonesInput = input(false, 'Premium/Discount Zones', group=ZONES_GROUP)
premiumZoneColorInput         = input.color(RED,  'Premium Zone',       group=ZONES_GROUP)
equilibriumZoneColorInput     = input.color(GRAY, 'Equilibrium Zone',   group=ZONES_GROUP)
discountZoneColorInput        = input.color(GREEN,'Discount Zone',      group=ZONES_GROUP)

// ── SMC UDTs ────────────────────────────────────────────────────────────────
type alerts
    bool internalBullishBOS = false
    bool internalBearishBOS = false
    bool internalBullishCHoCH = false
    bool internalBearishCHoCH = false
    bool swingBullishBOS = false
    bool swingBearishBOS = false
    bool swingBullishCHoCH = false
    bool swingBearishCHoCH = false
    bool internalBullishOrderBlock = false
    bool internalBearishOrderBlock = false
    bool swingBullishOrderBlock = false
    bool swingBearishOrderBlock = false
    bool equalHighs = false
    bool equalLows = false
    bool bullishFairValueGap = false
    bool bearishFairValueGap = false

type trailingExtremes
    float top
    float bottom
    int barTime
    int barIndex
    int lastTopTime
    int lastBottomTime

type fairValueGap
    float top
    float bottom
    int bias
    box topBox
    box bottomBox

type trend
    int bias

type equalDisplay
    line  l_ine  = na
    label l_abel = na

type pivot
    float currentLevel
    float lastLevel
    bool  crossed
    int   barTime  = time
    int   barIndex = bar_index

type orderBlock
    float barHigh
    float barLow
    int   barTime
    int   bias

// ── SMC State Variables ─────────────────────────────────────────────────────
var pivot swingHigh    = pivot.new(na, na, false)
var pivot swingLow     = pivot.new(na, na, false)
var pivot internalHigh = pivot.new(na, na, false)
var pivot internalLow  = pivot.new(na, na, false)
var pivot equalHigh    = pivot.new(na, na, false)
var pivot equalLow     = pivot.new(na, na, false)
var trend swingTrend   = trend.new(0)
var trend internalTrend= trend.new(0)
var equalDisplay equalHighDisplay = equalDisplay.new()
var equalDisplay equalLowDisplay  = equalDisplay.new()
var array<fairValueGap> fairValueGaps     = array.new<fairValueGap>()
var array<float>  parsedHighs  = array.new<float>()
var array<float>  parsedLows   = array.new<float>()
var array<float>  highs        = array.new<float>()
var array<float>  lows         = array.new<float>()
var array<int>    times        = array.new<int>()
var trailingExtremes trailing  = trailingExtremes.new()
var array<orderBlock> swingOrderBlocks    = array.new<orderBlock>()
var array<orderBlock> internalOrderBlocks = array.new<orderBlock>()
var array<box>    swingOrderBlocksBoxes   = array.new<box>()
var array<box>    internalOrderBlocksBoxes= array.new<box>()

var swingBullishColor       = styleInput == MONOCHROME ? MONO_BULLISH : swingBullColorInput
var swingBearishColor       = styleInput == MONOCHROME ? MONO_BEARISH : swingBearColorInput
var fairValueGapBullishColor= styleInput == MONOCHROME ? color.new(MONO_BULLISH,70) : fairValueGapsBullColorInput
var fairValueGapBearishColor= styleInput == MONOCHROME ? color.new(MONO_BEARISH,70) : fairValueGapsBearColorInput
var premiumZoneColor        = styleInput == MONOCHROME ? MONO_BEARISH : premiumZoneColorInput
var discountZoneColor       = styleInput == MONOCHROME ? MONO_BULLISH : discountZoneColorInput

var line liveBullishLine = na
var line liveBearishLine = na

var initialTime = time

if barstate.isfirst
    if show_smc and showSwingOrderBlocksInput
        for index = 1 to swingOrderBlocksSizeInput
            swingOrderBlocksBoxes.push(box.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right))
    if show_smc and showInternalOrderBlocksInput
        for index = 1 to internalOrderBlocksSizeInput
            internalOrderBlocksBoxes.push(box.new(na, na, na, na, xloc=xloc.bar_time, extend=extend.right))

// ── SMC Core Functions ──────────────────────────────────────────────────────
bearishOrderBlockMitigationSource = orderBlockMitigationInput == CLOSE ? close : high
bullishOrderBlockMitigationSource = orderBlockMitigationInput == CLOSE ? close : low

volatilityMeasure = orderBlockFilterInput == ATR ? atr_shared_200 : ta.cum(ta.tr) / bar_index
highVolatilityBar = high - low >= 2 * volatilityMeasure
parsedHigh = highVolatilityBar ? low  : high
parsedLow  = highVolatilityBar ? high : low

// ── SMC arrays: cap growth to last 500 bars ──────────────────────────────
SMC_ARRAY_CAP = 500
if parsedHighs.size() >= SMC_ARRAY_CAP
    parsedHighs.shift()
    parsedLows.shift()
    highs.shift()
    lows.shift()
    times.shift()
parsedHighs.push(parsedHigh)
parsedLows.push(parsedLow)
highs.push(high)
lows.push(low)
times.push(time)

alerts currentAlerts = alerts.new()

leg(int size) =>
    var leg = 0
    newLegHigh = high[size] > ta.highest(size)
    newLegLow  = low[size]  < ta.lowest(size)
    if newLegHigh
        leg := BEARISH_LEG
    else if newLegLow
        leg := BULLISH_LEG
    leg

startOfNewLeg(int leg)      => ta.change(leg) != 0
startOfBearishLeg(int leg)  => ta.change(leg) == -1
startOfBullishLeg(int leg)  => ta.change(leg) == +1

drawLabel(int labelTime, float labelPrice, string tag, color labelColor, string labelStyle) =>
    var label l_abel = na
    if modeInput == PRESENT
        l_abel.delete()
    l_abel := label.new(chart.point.new(labelTime, na, labelPrice), tag, xloc=xloc.bar_time, color=color(na), textcolor=labelColor, style=labelStyle, size=size.small)
    l_abel

drawEqualHighLow(pivot p_ivot, float level, int size, bool equalHigh) =>
    equalDisplay e_qualDisplay = equalHigh ? equalHighDisplay : equalLowDisplay
    string tag = 'EQL'
    color  equalColor   = swingBullishColor
    string labelStyle   = label.style_label_up
    if equalHigh
        tag        := 'EQH'
        equalColor := swingBearishColor
        labelStyle := label.style_label_down
    if modeInput == PRESENT
        line.delete(e_qualDisplay.l_ine)
        label.delete(e_qualDisplay.l_abel)
    e_qualDisplay.l_ine  := line.new(chart.point.new(p_ivot.barTime, na, p_ivot.currentLevel), chart.point.new(time[size], na, level), xloc=xloc.bar_time, color=equalColor, style=line.style_dotted)
    labelPosition         = math.round(0.5 * (p_ivot.barIndex + bar_index - size))
    e_qualDisplay.l_abel := label.new(chart.point.new(na, labelPosition, level), tag, xloc=xloc.bar_index, color=color(na), textcolor=equalColor, style=labelStyle, size=equalHighsLowsSizeInput)
    e_qualDisplay.l_abel

getCurrentStructure(int size, bool equalHighLow=false, bool internal=false) =>
    currentLeg = leg(size)
    newPivot   = startOfNewLeg(currentLeg)
    pivotLow   = startOfBullishLeg(currentLeg)
    pivotHigh  = startOfBearishLeg(currentLeg)
    if newPivot
        if pivotLow
            pivot p_ivot = equalHighLow ? equalLow : internal ? internalLow : swingLow
            if equalHighLow and math.abs(p_ivot.currentLevel - low[size]) < equalHighsLowsThresholdInput * atr_shared
                drawEqualHighLow(p_ivot, low[size], size, false)
                currentAlerts.equalLows := true
            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := low[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]
            if not equalHighLow and not internal
                trailing.bottom        := p_ivot.currentLevel
                trailing.barTime       := p_ivot.barTime
                trailing.barIndex      := p_ivot.barIndex
                trailing.lastBottomTime:= p_ivot.barTime
            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel < p_ivot.lastLevel ? 'LL' : 'HL', swingBullishColor, label.style_label_up)
        else
            pivot p_ivot = equalHighLow ? equalHigh : internal ? internalHigh : swingHigh
            if equalHighLow and math.abs(p_ivot.currentLevel - high[size]) < equalHighsLowsThresholdInput * atr_shared
                drawEqualHighLow(p_ivot, high[size], size, true)
                currentAlerts.equalHighs := true
            p_ivot.lastLevel    := p_ivot.currentLevel
            p_ivot.currentLevel := high[size]
            p_ivot.crossed      := false
            p_ivot.barTime      := time[size]
            p_ivot.barIndex     := bar_index[size]
            if not equalHighLow and not internal
                trailing.top        := p_ivot.currentLevel
                trailing.barTime    := p_ivot.barTime
                trailing.barIndex   := p_ivot.barIndex
                trailing.lastTopTime:= p_ivot.barTime
            if showSwingsInput and not internal and not equalHighLow
                drawLabel(time[size], p_ivot.currentLevel, p_ivot.currentLevel > p_ivot.lastLevel ? 'HH' : 'LH', swingBearishColor, label.style_label_down)

drawStructure(pivot p_ivot, string tag, color structureColor, string lineStyle, string labelStyle, string labelSize) =>
    var line  l_ine  = line.new(na, na, na, na, xloc=xloc.bar_time)
    var label l_abel = label.new(na, na)
    if modeInput == PRESENT
        l_ine.delete()
        l_abel.delete()
    l_ine  := line.new(chart.point.new(p_ivot.barTime, na, p_ivot.currentLevel), chart.point.new(time, na, p_ivot.currentLevel), xloc.bar_time, color=structureColor, style=lineStyle)
    l_abel := label.new(chart.point.new(na, math.round(0.5*(p_ivot.barIndex+bar_index)), p_ivot.currentLevel), tag, xloc=xloc.bar_index, color=color(na), textcolor=structureColor, style=labelStyle, size=labelSize)
    l_abel

deleteOrderBlocks(bool internal=false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    for [index, eachOrderBlock] in orderBlocks
        bool crossedOderBlock = false
        if bearishOrderBlockMitigationSource > eachOrderBlock.barHigh and eachOrderBlock.bias == BEARISH
            crossedOderBlock := true
            if internal
                currentAlerts.internalBearishOrderBlock := true
            else
                currentAlerts.swingBearishOrderBlock := true
        else if bullishOrderBlockMitigationSource < eachOrderBlock.barLow and eachOrderBlock.bias == BULLISH
            crossedOderBlock := true
            if internal
                currentAlerts.internalBullishOrderBlock := true
            else
                currentAlerts.swingBullishOrderBlock := true
        if crossedOderBlock
            orderBlocks.remove(index)

storeOrdeBlock(pivot p_ivot, int bias, bool internal=false) =>
    if not internal and showSwingOrderBlocksInput or internal and showInternalOrderBlocksInput
        array<float> a_rray = na
        int parsedIndex = na
        // Convert absolute bar_index to 0-based array index (arrays are capped at SMC_ARRAY_CAP)
        int arrayStartBarIndex = bar_index - parsedHighs.size() + 1
        int clampedPivotIndex   = math.max(p_ivot.barIndex - arrayStartBarIndex, 0)
        int currentArrayIndex   = bar_index - arrayStartBarIndex
        if bias == BEARISH
            a_rray      := parsedHighs.slice(clampedPivotIndex, currentArrayIndex)
            parsedIndex := clampedPivotIndex + a_rray.indexof(a_rray.max())
        else
            a_rray      := parsedLows.slice(clampedPivotIndex, currentArrayIndex)
            parsedIndex := clampedPivotIndex + a_rray.indexof(a_rray.min())
        orderBlock o_rderBlock = orderBlock.new(parsedHighs.get(parsedIndex), parsedLows.get(parsedIndex), times.get(parsedIndex), bias)
        array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
        if orderBlocks.size() >= 100
            orderBlocks.pop()
        orderBlocks.unshift(o_rderBlock)

drawOrderBlocks(bool internal=false) =>
    array<orderBlock> orderBlocks = internal ? internalOrderBlocks : swingOrderBlocks
    orderBlocksSize = orderBlocks.size()
    if orderBlocksSize > 0
        maxOrderBlocks = internal ? internalOrderBlocksSizeInput : swingOrderBlocksSizeInput
        array<orderBlock> parsedOrdeBlocks = orderBlocks.slice(0, math.min(maxOrderBlocks, orderBlocksSize))
        array<box> b_oxes = internal ? internalOrderBlocksBoxes : swingOrderBlocksBoxes
        for [index, eachOrderBlock] in parsedOrdeBlocks
            orderBlockColor = styleInput == MONOCHROME ? eachOrderBlock.bias == BEARISH ? color.new(MONO_BEARISH,80) : color.new(MONO_BULLISH,80) : internal ? eachOrderBlock.bias == BEARISH ? internalBearishOrderBlockColor : internalBullishOrderBlockColor : eachOrderBlock.bias == BEARISH ? swingBearishOrderBlockColor : swingBullishOrderBlockColor
            box b_ox = b_oxes.get(index)
            b_ox.set_top_left_point(chart.point.new(eachOrderBlock.barTime, na, eachOrderBlock.barHigh))
            b_ox.set_bottom_right_point(chart.point.new(last_bar_time, na, eachOrderBlock.barLow))
            b_ox.set_border_color(internal ? na : orderBlockColor)
            b_ox.set_bgcolor(orderBlockColor)

displayStructure(bool internal=false) =>
    var bullishBar = true
    var bearishBar = true
    if internalFilterConfluenceInput
        bullishBar := high - math.max(close, open) > math.min(close, open - low)
        bearishBar := high - math.max(close, open) < math.min(close, open - low)
    pivot p_ivot        = internal ? internalHigh : swingHigh
    trend t_rend        = internal ? internalTrend : swingTrend
    lineStyle           = internal ? line.style_dashed : line.style_solid
    labelSize           = internal ? internalStructureSize : swingStructureSize
    extraCondition      = internal ? internalHigh.currentLevel != swingHigh.currentLevel and bullishBar : true
    bullishColor        = styleInput == MONOCHROME ? MONO_BULLISH : internal ? internalBullColorInput : swingBullColorInput
    if ta.crossover(close, p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BEARISH ? CHOCH : BOS
        if internal
            currentAlerts.internalBullishCHoCH := tag == CHOCH
            currentAlerts.internalBullishBOS   := tag == BOS
        else
            currentAlerts.swingBullishCHoCH := tag == CHOCH
            currentAlerts.swingBullishBOS   := tag == BOS
        p_ivot.crossed  := true
        t_rend.bias     := BULLISH
        displayCondition = internal ? showInternalsInput and (showInternalBullInput == ALL or showInternalBullInput == BOS and tag != CHOCH or showInternalBullInput == CHOCH and tag == CHOCH) : showStructureInput and (showSwingBullInput == ALL or showSwingBullInput == BOS and tag != CHOCH or showSwingBullInput == CHOCH and tag == CHOCH)
        if displayCondition
            drawStructure(p_ivot, tag, bullishColor, lineStyle, label.style_label_down, labelSize)
        if internal and showInternalOrderBlocksInput or not internal and showSwingOrderBlocksInput
            storeOrdeBlock(p_ivot, BULLISH, internal)
    p_ivot              := internal ? internalLow : swingLow
    extraCondition      := internal ? internalLow.currentLevel != swingLow.currentLevel and bearishBar : true
    bearishColor        = styleInput == MONOCHROME ? MONO_BEARISH : internal ? internalBearColorInput : swingBearColorInput
    if ta.crossunder(close, p_ivot.currentLevel) and not p_ivot.crossed and extraCondition
        string tag = t_rend.bias == BULLISH ? CHOCH : BOS
        if internal
            currentAlerts.internalBearishCHoCH := tag == CHOCH
            currentAlerts.internalBearishBOS   := tag == BOS
        else
            currentAlerts.swingBearishCHoCH := tag == CHOCH
            currentAlerts.swingBearishBOS   := tag == BOS
        p_ivot.crossed  := true
        t_rend.bias     := BEARISH
        displayCondition = internal ? showInternalsInput and (showInternalBearInput == ALL or showInternalBearInput == BOS and tag != CHOCH or showInternalBearInput == CHOCH and tag == CHOCH) : showStructureInput and (showSwingBearInput == ALL or showSwingBearInput == BOS and tag != CHOCH or showSwingBearInput == CHOCH and tag == CHOCH)
        if displayCondition
            drawStructure(p_ivot, tag, bearishColor, lineStyle, label.style_label_up, labelSize)
        if internal and showInternalOrderBlocksInput or not internal and showSwingOrderBlocksInput
            storeOrdeBlock(p_ivot, BEARISH, internal)

fairValueGapBox(leftTime, rightTime, topPrice, bottomPrice, boxColor) =>
    box.new(chart.point.new(leftTime, na, topPrice), chart.point.new(rightTime + fairValueGapsExtendInput * (time - time[1]), na, bottomPrice), xloc=xloc.bar_time, border_color=boxColor, bgcolor=boxColor)

deleteFairValueGaps() =>
    for [index, eachFairValueGap] in fairValueGaps
        if low < eachFairValueGap.bottom and eachFairValueGap.bias == BULLISH or high > eachFairValueGap.top and eachFairValueGap.bias == BEARISH
            eachFairValueGap.topBox.delete()
            eachFairValueGap.bottomBox.delete()
            fairValueGaps.remove(index)

drawFairValueGaps() =>
    [lastClose, lastOpen, lastTime, currentHigh, currentLow, currentTime, last2High, last2Low] = request.security(syminfo.tickerid, fairValueGapsTimeframeInput, [close[1], open[1], time[1], high[0], low[0], time[0], high[2], low[2]], lookahead=barmerge.lookahead_on)
    barDeltaPercent        = (lastClose - lastOpen) / (lastOpen * 100)
    newTimeframe           = timeframe.change(fairValueGapsTimeframeInput)
    threshold              = fairValueGapsThresholdInput ? ta.cum(math.abs(newTimeframe ? barDeltaPercent : 0)) / bar_index * 2 : 0
    bullishFairValueGap    = currentLow > last2High and lastClose > last2High and barDeltaPercent > threshold and newTimeframe
    bearishFairValueGap    = currentHigh < last2Low and lastClose < last2Low and -barDeltaPercent > threshold and newTimeframe
    if bullishFairValueGap
        currentAlerts.bullishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentLow, last2High, BULLISH, fairValueGapBox(lastTime, currentTime, currentLow, math.avg(currentLow, last2High), fairValueGapBullishColor), fairValueGapBox(lastTime, currentTime, math.avg(currentLow, last2High), last2High, fairValueGapBullishColor)))
    if bearishFairValueGap
        currentAlerts.bearishFairValueGap := true
        fairValueGaps.unshift(fairValueGap.new(currentHigh, last2Low, BEARISH, fairValueGapBox(lastTime, currentTime, currentHigh, math.avg(currentHigh, last2Low), fairValueGapBearishColor), fairValueGapBox(lastTime, currentTime, math.avg(currentHigh, last2Low), last2Low, fairValueGapBearishColor)))

getStyle(string style) =>
    switch style
        SOLID  => line.style_solid
        DASHED => line.style_dashed
        DOTTED => line.style_dotted

drawLevels(string timeframe, bool sameTimeframe, string style, color levelColor) =>
    [topLevel, bottomLevel, leftTime, rightTime] = request.security(syminfo.tickerid, timeframe, [high[1], low[1], time[1], time], lookahead=barmerge.lookahead_on)
    float parsedTop     = sameTimeframe ? high : topLevel
    float parsedBottom  = sameTimeframe ? low  : bottomLevel
    int   parsedLeftTime  = sameTimeframe ? time : leftTime
    int   parsedRightTime = sameTimeframe ? time : rightTime
    int   parsedTopTime   = time
    int   parsedBottomTime= time
    if not sameTimeframe
        int leftIndex   = times.binary_search_rightmost(parsedLeftTime)
        int rightIndex  = times.binary_search_rightmost(parsedRightTime)
        array<int>   timeArray   = times.slice(leftIndex, rightIndex)
        array<float> topArray    = highs.slice(leftIndex, rightIndex)
        array<float> bottomArray = lows.slice(leftIndex, rightIndex)
        parsedTopTime    := timeArray.size() > 0 ? timeArray.get(topArray.indexof(topArray.max()))    : initialTime
        parsedBottomTime := timeArray.size() > 0 ? timeArray.get(bottomArray.indexof(bottomArray.min())) : initialTime
    var line  topLine    = line.new(na, na, na, na, xloc=xloc.bar_time, color=levelColor, style=getStyle(style))
    var line  bottomLine = line.new(na, na, na, na, xloc=xloc.bar_time, color=levelColor, style=getStyle(style))
    var label topLabel   = label.new(na, na, xloc=xloc.bar_time, text=str.format('P{0}H', timeframe), color=color(na), textcolor=levelColor, size=size.small, style=label.style_label_left)
    var label bottomLabel= label.new(na, na, xloc=xloc.bar_time, text=str.format('P{0}L', timeframe), color=color(na), textcolor=levelColor, size=size.small, style=label.style_label_left)
    topLine.set_first_point(chart.point.new(parsedTopTime, na, parsedTop))
    topLine.set_second_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedTop))
    topLabel.set_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedTop))
    bottomLine.set_first_point(chart.point.new(parsedBottomTime, na, parsedBottom))
    bottomLine.set_second_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedBottom))
    bottomLabel.set_point(chart.point.new(last_bar_time + 20 * (time - time[1]), na, parsedBottom))

higherTimeframe(string timeframe) =>
    timeframe.in_seconds() > timeframe.in_seconds(timeframe)

updateTrailingExtremes() =>
    trailing.top            := math.max(high, trailing.top)
    trailing.lastTopTime    := trailing.top == high ? time : trailing.lastTopTime
    trailing.bottom         := math.min(low, trailing.bottom)
    trailing.lastBottomTime := trailing.bottom == low ? time : trailing.lastBottomTime
    trailing.lastBottomTime

drawHighLowSwings() =>
    var line  topLine    = line.new(na, na, na, na, color=swingBearishColor, xloc=xloc.bar_time)
    var line  bottomLine = line.new(na, na, na, na, color=swingBullishColor, xloc=xloc.bar_time)
    var label topLabel   = label.new(na, na, "", color=color(na), textcolor=swingBearishColor, xloc=xloc.bar_time, style=label.style_label_down, size=size.tiny)
    var label bottomLabel= label.new(na, na, "", color=color(na), textcolor=swingBullishColor, xloc=xloc.bar_time, style=label.style_label_up,   size=size.tiny)
    rightTimeBar = last_bar_time + 20 * (time - time[1])
    topLine.set_first_point(chart.point.new(trailing.lastTopTime, na, trailing.top))
    topLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_point(chart.point.new(rightTimeBar, na, trailing.top))
    topLabel.set_text(swingTrend.bias == BEARISH ? 'Strong High' : 'Weak High')
    bottomLine.set_first_point(chart.point.new(trailing.lastBottomTime, na, trailing.bottom))
    bottomLine.set_second_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_point(chart.point.new(rightTimeBar, na, trailing.bottom))
    bottomLabel.set_text(swingTrend.bias == BULLISH ? 'Strong Low' : 'Weak Low')

drawZone(float labelLevel, int labelIndex, float top, float bottom, string tag, color zoneColor, string style) =>
    var label l_abel = label.new(na, na, text=tag, color=color(na), textcolor=zoneColor, style=style, size=size.small)
    var box   b_ox   = box.new(na, na, na, na, bgcolor=color.new(zoneColor,80), border_color=color(na), xloc=xloc.bar_time)
    b_ox.set_top_left_point(chart.point.new(trailing.barTime, na, top))
    b_ox.set_bottom_right_point(chart.point.new(last_bar_time, na, bottom))
    l_abel.set_point(chart.point.new(na, labelIndex, labelLevel))

drawPremiumDiscountZones() =>
    drawZone(trailing.top, math.round(0.5*(trailing.barIndex+last_bar_index)), trailing.top, 0.95*trailing.top+0.05*trailing.bottom, 'Premium', premiumZoneColor, label.style_label_down)
    equilibriumLevel = math.avg(trailing.top, trailing.bottom)
    drawZone(equilibriumLevel, last_bar_index, 0.525*trailing.top+0.475*trailing.bottom, 0.525*trailing.bottom+0.475*trailing.top, 'Equilibrium', equilibriumZoneColorInput, label.style_label_left)
    drawZone(trailing.bottom, math.round(0.5*(trailing.barIndex+last_bar_index)), 0.95*trailing.bottom+0.05*trailing.top, trailing.bottom, 'Discount', discountZoneColor, label.style_label_up)

// ── SMC Execution ───────────────────────────────────────────────────────────
candleColor = internalTrend.bias == BULLISH ? swingBullishColor : swingBearishColor
barcolor(show_smc and showTrendInput ? candleColor : na, title="SMC Trend Candles")

if show_smc
    if showHighLowSwingsInput or showPremiumDiscountZonesInput
        updateTrailingExtremes()
        if showHighLowSwingsInput
            drawHighLowSwings()
        if showPremiumDiscountZonesInput
            drawPremiumDiscountZones()

    if showFairValueGapsInput
        deleteFairValueGaps()

    getCurrentStructure(swingsLengthInput, false)
    getCurrentStructure(5, false, true)

    if showEqualHighsLowsInput
        getCurrentStructure(equalHighsLowsLengthInput, true)

    if showInternalsInput or showInternalOrderBlocksInput or showTrendInput
        displayStructure(true)

    if showStructureInput or showSwingOrderBlocksInput or showHighLowSwingsInput
        displayStructure()

    if showInternalOrderBlocksInput
        deleteOrderBlocks(true)

    if showSwingOrderBlocksInput
        deleteOrderBlocks()

    if showFairValueGapsInput
        drawFairValueGaps()

if show_smc and (barstate.islastconfirmedhistory or barstate.islast)
    if showInternalOrderBlocksInput
        drawOrderBlocks(true)
    if showSwingOrderBlocksInput
        drawOrderBlocks()
    if barstate.islastconfirmedhistory or barstate.isnew
        if showDailyLevelsInput and not higherTimeframe('D')
            drawLevels('D', timeframe.isdaily, dailyLevelsStyleInput, dailyLevelsColorInput)
        if showWeeklyLevelsInput and not higherTimeframe('W')
            drawLevels('W', timeframe.isweekly, weeklyLevelsStyleInput, weeklyLevelsColorInput)
        if showMonthlyLevelsInput and not higherTimeframe('M')
            drawLevels('M', timeframe.ismonthly, monthlyLevelsStyleInput, monthlyLevelsColorInput)

if show_smc and barstate.islast and barstate.isrealtime
    line.delete(liveBullishLine)
    line.delete(liveBearishLine)
    liveBullishLine := na
    liveBearishLine := na
    if not swingHigh.crossed and not na(swingHigh.currentLevel)
        if high > swingHigh.currentLevel and high[1] <= swingHigh.currentLevel
            liveBullishLine := line.new(chart.point.new(swingHigh.barTime, na, swingHigh.currentLevel), chart.point.new(time, na, high), xloc=xloc.bar_time, color=color.black, style=line.style_dashed, width=2)
    if not swingLow.crossed and not na(swingLow.currentLevel)
        if low < swingLow.currentLevel and low[1] >= swingLow.currentLevel
            liveBearishLine := line.new(chart.point.new(swingLow.barTime, na, swingLow.currentLevel), chart.point.new(time, na, low), xloc=xloc.bar_time, color=color.black, style=line.style_dashed, width=2)

// ═══════════════════════════════════════════════════════════════════════════════
// 04. MTF TABLE
// ═══════════════════════════════════════════════════════════════════════════════
grp_mtf      = "═══════════ 04. MTF Table ═══════════"

emaFast_oww  = input.int(10, "EMA Fast Length",    minval=1, group=grp_mtf)
emaSlow_oww  = input.int(20, "EMA Slow Length",    minval=1, group=grp_mtf)
rsiLength_oww= input.int(14, "RSI Length",         minval=1, group=grp_mtf)
macdFast_oww = input.int(12, "MACD Fast Length",   minval=1, group=grp_mtf)
macdSlow_oww = input.int(26, "MACD Slow Length",   minval=1, group=grp_mtf)
macdSig_oww  = input.int(9,  "MACD Signal Length", minval=1, group=grp_mtf)
tf1_oww = input.timeframe("240", "TF 1", group=grp_mtf)
tf2_oww = input.timeframe("120", "TF 2", group=grp_mtf)
tf3_oww = input.timeframe("60",  "TF 3", group=grp_mtf)
tf4_oww = input.timeframe("30",  "TF 4", group=grp_mtf)
tf5_oww = input.timeframe("15",  "TF 5", group=grp_mtf)
tf6_oww = input.timeframe("5",   "TF 6", group=grp_mtf)
tf7_oww = input.timeframe("3",   "TF 7", group=grp_mtf)
tf8_oww = input.timeframe("1",   "TF 8", group=grp_mtf)
posInput_oww = input.string("Top Right", "Table Position", options=["Top Left","Top Right","Bottom Left","Bottom Right"], group=grp_mtf)

f_pos_oww(string p) =>
    switch p
        "Top Left"    => position.top_left
        "Top Right"   => position.top_right
        "Bottom Left" => position.bottom_left
        =>               position.bottom_right

f_tfLabel_oww(string tf) =>
    switch tf
        "1"   => "1m"
        "3"   => "3m"
        "5"   => "5m"
        "10"  => "10"
        "15"  => "15"
        "30"  => "30"
        "45"  => "45"
        "60"  => "1h"
        "120" => "2h"
        "180" => "3h"
        "240" => "4h"
        "360" => "6h"
        "480" => "8h"
        "720" => "12"
        "D"   => "1D"
        "W"   => "1W"
        "M"   => "1M"
        =>        tf

f_sym_oww(int v) => v == 1 ? "▲" : v == -1 ? "▼" : "—"
f_bg_oww(int v)  => v == 1 ? color.new(color.lime,30) : v == -1 ? color.new(color.red,30) : color.new(color.gray,50)

f_allSignals_oww(int fastLen, int slowLen, int rsiLen, int mFast, int mSlow, int mSig) =>
    float fastEma  = ta.ema(close, fastLen)
    float slowEma  = ta.ema(close, slowLen)
    int   xo       = fastEma > slowEma ? 1 : fastEma < slowEma ? -1 : 0
    int   vw       = close > ta.vwap ? 1 : close < ta.vwap ? -1 : 0
    float rsiVal   = ta.rsi(close, rsiLen)
    int   rs       = rsiVal > 50 ? 1 : rsiVal < 50 ? -1 : 0
    [ml, sl, _]   = ta.macd(close, mFast, mSlow, mSig)
    int   mc       = ml > sl ? 1 : ml < sl ? -1 : 0
    [xo, vw, rs, mc]

// ── MTF security calls — always fetched (Pine requirement), used only when show_mtf
[e1,v1,r1,m1_oww] = request.security(syminfo.tickerid, tf1_oww, f_allSignals_oww(emaFast_oww, emaSlow_oww, rsiLength_oww, macdFast_oww, macdSlow_oww, macdSig_oww))
[e2,v2,r2,m2_oww] = request.security(syminfo.tickerid, tf2_oww, f_allSignals_oww(emaFast_oww, emaSlow_oww, rsiLength_oww, macdFast_oww, macdSlow_oww, macdSig_oww))
[e3,v3,r3,m3_oww] = request.security(syminfo.tickerid, tf3_oww, f_allSignals_oww(emaFast_oww, emaSlow_oww, rsiLength_oww, macdFast_oww, macdSlow_oww, macdSig_oww))
[e4,v4,r4,m4_oww] = request.security(syminfo.tickerid, tf4_oww, f_allSignals_oww(emaFast_oww, emaSlow_oww, rsiLength_oww, macdFast_oww, macdSlow_oww, macdSig_oww))
[e5,v5,r5,m5_oww] = request.security(syminfo.tickerid, tf5_oww, f_allSignals_oww(emaFast_oww, emaSlow_oww, rsiLength_oww, macdFast_oww, macdSlow_oww, macdSig_oww))
[e6,v6,r6,m6_oww] = request.security(syminfo.tickerid, tf6_oww, f_allSignals_oww(emaFast_oww, emaSlow_oww, rsiLength_oww, macdFast_oww, macdSlow_oww, macdSig_oww))
[e7,v7,r7,m7_oww] = request.security(syminfo.tickerid, tf7_oww, f_allSignals_oww(emaFast_oww, emaSlow_oww, rsiLength_oww, macdFast_oww, macdSlow_oww, macdSig_oww))
[e8,v8,r8,m8_oww] = request.security(syminfo.tickerid, tf8_oww, f_allSignals_oww(emaFast_oww, emaSlow_oww, rsiLength_oww, macdFast_oww, macdSlow_oww, macdSig_oww))

var table mtfTable_oww = table.new(f_pos_oww(posInput_oww), 5, 9, frame_color=color.gray, border_width=1, border_color=color.gray, bgcolor=color.black)

if barstate.isfirst
    table.cell(mtfTable_oww, 0, 0, "TF", bgcolor=color.black, text_color=color.white, text_size=size.tiny, width=3, height=2)
    table.cell(mtfTable_oww, 1, 0, "XO", bgcolor=color.black, text_color=color.white, text_size=size.tiny, width=3, height=2)
    table.cell(mtfTable_oww, 2, 0, "VW", bgcolor=color.black, text_color=color.white, text_size=size.tiny, width=3, height=2)
    table.cell(mtfTable_oww, 3, 0, "RS", bgcolor=color.black, text_color=color.white, text_size=size.tiny, width=3, height=2)
    table.cell(mtfTable_oww, 4, 0, "MC", bgcolor=color.black, text_color=color.white, text_size=size.tiny, width=3, height=2)

if barstate.islast and show_mtf
    string[] tfs  = array.from(f_tfLabel_oww(tf1_oww), f_tfLabel_oww(tf2_oww), f_tfLabel_oww(tf3_oww), f_tfLabel_oww(tf4_oww), f_tfLabel_oww(tf5_oww), f_tfLabel_oww(tf6_oww), f_tfLabel_oww(tf7_oww), f_tfLabel_oww(tf8_oww))
    int[]    ema  = array.from(e1, e2, e3, e4, e5, e6, e7, e8)
    int[]    vwap = array.from(v1, v2, v3, v4, v5, v6, v7, v8)
    int[]    rsi  = array.from(r1, r2, r3, r4, r5, r6, r7, r8)
    int[]    macd = array.from(m1_oww, m2_oww, m3_oww, m4_oww, m5_oww, m6_oww, m7_oww, m8_oww)
    for i = 0 to 7
        r = i + 1
        table.cell(mtfTable_oww, 0, r, tfs.get(i),                bgcolor=color.black,       text_color=color.white, text_size=size.tiny, width=3, height=2)
        table.cell(mtfTable_oww, 1, r, f_sym_oww(ema.get(i)),  bgcolor=f_bg_oww(ema.get(i)),  text_color=color.white, text_size=size.tiny, width=3, height=2)
        table.cell(mtfTable_oww, 2, r, f_sym_oww(vwap.get(i)), bgcolor=f_bg_oww(vwap.get(i)), text_color=color.white, text_size=size.tiny, width=3, height=2)
        table.cell(mtfTable_oww, 3, r, f_sym_oww(rsi.get(i)),  bgcolor=f_bg_oww(rsi.get(i)),  text_color=color.white, text_size=size.tiny, width=3, height=2)
        table.cell(mtfTable_oww, 4, r, f_sym_oww(macd.get(i)), bgcolor=f_bg_oww(macd.get(i)), text_color=color.white, text_size=size.tiny, width=3, height=2)

if barstate.islast and not show_mtf
    hideColor = color.new(color.black, 100)
    for row = 0 to 8
        for col = 0 to 4
            table.cell_set_bgcolor(mtfTable_oww, col, row, hideColor)
            table.cell_set_text_color(mtfTable_oww, col, row, hideColor)

// ═══════════════════════════════════════════════════════════════════════════════
// 05. NEXT CANDLE PREDICTOR
// ═══════════════════════════════════════════════════════════════════════════════
grp_ncp        = "═══════════ 05. Next Candle Prediction ═══════════"

atrLength      = input.int(14, "ATR Period", group=grp_ncp, minval=5, maxval=50)
stFactor       = input.float(3.0, "Trend Factor", group=grp_ncp, minval=1.0, maxval=5.0, step=0.1)
stPeriod       = input.int(10, "Trend ATR Period", group=grp_ncp, minval=5, maxval=30)
adxThreshold   = input.int(25, "ADX Threshold", group=grp_ncp, minval=15, maxval=40)
minVolumeRatio = input.float(0.8, "Min Volume Ratio", group=grp_ncp, minval=0.5, maxval=2.0, step=0.1)
minConfluence  = input.int(5, "Min Confluence (1-8)", group=grp_ncp, minval=3, maxval=8)

grp_proj = "05. Projection Settings"
barShift = input.int(1, "Prediction Bar Shift (Right)", minval=1, maxval=10, step=1, group=grp_proj, tooltip="Shift prediction candles to the right. 1x = closest, 10x = furthest")

colLong         = #089981
colShort        = #f23645
colText         = #ffffff
colFTBackground = #FCD0AF
colGray         = #787b86

// ── SuperTrend for NCP (gated by show_ncp, but var state maintained) ───────
var float upperBand      = na
var float lowerBand      = na
var int   trendDirection = 1
var bool  isUptrend      = false
var bool  isDowntrend    = false

if show_ncp
    trendAtr     = ta.atr(stPeriod)
    hl2Value     = hl2
    upperBandRaw = hl2Value + stFactor * trendAtr
    lowerBandRaw = hl2Value - stFactor * trendAtr

    prevUpperBand = nz(upperBand[1], upperBandRaw)
    prevLowerBand = nz(lowerBand[1], lowerBandRaw)

    lowerBand := close[1] > prevLowerBand ? math.max(lowerBandRaw, prevLowerBand) : lowerBandRaw
    upperBand := close[1] < prevUpperBand ? math.min(upperBandRaw, prevUpperBand) : upperBandRaw

    if nz(trendDirection[1], 1) == -1
        trendDirection := close < lowerBand ? 1 : -1
    else
        trendDirection := close > upperBand ? -1 : 1

    isUptrend   := trendDirection == -1
    isDowntrend := trendDirection == 1

// ── NCP calculations (gated by show_ncp) ──────────────────────────────────
var int    longPct    = 50
var int    shortPct   = 50
var float  atr_ncp    = na
var float  avgBody    = na
var string volRegime  = "MEDIUM"

if show_ncp
    atr_ncp     := atrLength == 14 ? atr_shared : ta.atr(atrLength)
    avgBody     := ta.sma(math.abs(close - open), 5)

    ema8  = ta.ema(close, 8)
    ema21 = ta.ema(close, 21)
    ema50 = ta.ema(close, 50)

    rsi_ncp        = ta.rsi(close, 14)

    [macdLine, signalLine, macdHist] = ta.macd(close, 12, 26, 9)

    stochK = ta.stoch(close, high, low, 14)
    stochD = ta.sma(stochK, 3)

    volSma   = ta.sma(volume, 20)
    volRatio = nz(volume / volSma, 1.0)

    [diPlus, diMinus, adxValue] = ta.dmi(14, 14)

    candleRange   = high - low
    buyVolume     = candleRange > 0 ? volume * (close - low) / candleRange : volume * 0.5
    sellVolume    = candleRange > 0 ? volume * (high - close) / candleRange : volume * 0.5
    volumeDelta   = buyVolume - sellVolume
    deltaEma      = ta.ema(volumeDelta, 10)
    deltaMomentum = volumeDelta > deltaEma

    atrPercentile = ta.percentrank(atr_ncp, 100)
    volMultiplier = atrPercentile > 75 ? 0.85 : atrPercentile < 25 ? 1.15 : 1.0
    volRegime     := atrPercentile > 75 ? "HIGH" : atrPercentile < 25 ? "LOW" : "MEDIUM"

    adxScore        = adxValue > 35 ? 100 : adxValue > 30 ? 85 : adxValue > 25 ? 70 : adxValue > 20 ? 50 : 30
    volScore        = volRatio > 2.0 ? 100 : volRatio > 1.5 ? 80 : volRatio > 1.0 ? 60 : volRatio > 0.8 ? 45 : 25
    macdScoreLong   = macdLine > signalLine and macdHist > 0 ? 100 : macdLine > signalLine ? 70 : macdHist > 0 ? 50 : 20
    macdScoreShort  = macdLine < signalLine and macdHist < 0 ? 100 : macdLine < signalLine ? 70 : macdHist < 0 ? 50 : 20
    rsiScoreLong    = rsi_ncp < 30 ? 100 : rsi_ncp < 40 ? 85 : rsi_ncp < 50 ? 70 : rsi_ncp < 60 ? 50 : 25
    rsiScoreShort   = rsi_ncp > 70 ? 100 : rsi_ncp > 60 ? 85 : rsi_ncp > 50 ? 70 : rsi_ncp > 40 ? 50 : 25
    stochScoreLong  = stochK > stochD and stochK < 20 ? 100 : stochK > stochD and stochK < 50 ? 85 : stochK > stochD ? 65 : 25
    stochScoreShort = stochK < stochD and stochK > 80 ? 100 : stochK < stochD and stochK > 50 ? 85 : stochK < stochD ? 65 : 25
    deltaScoreLong  = volumeDelta > 0 and deltaMomentum ? 100 : volumeDelta > 0 ? 75 : volumeDelta > -math.abs(deltaEma) ? 40 : 20
    deltaScoreShort = volumeDelta < 0 and not deltaMomentum ? 100 : volumeDelta < 0 ? 75 : volumeDelta < math.abs(deltaEma) ? 40 : 20
    trendScoreLong  = isUptrend and ema8 > ema21 and ema21 > ema50 ? 100 : isUptrend and ema8 > ema21 ? 80 : isUptrend ? 60 : 0
    trendScoreShort = isDowntrend and ema8 < ema21 and ema21 < ema50 ? 100 : isDowntrend and ema8 < ema21 ? 80 : isDowntrend ? 60 : 0

    longScoreRaw  = trendScoreLong * 0.23 + macdScoreLong * 0.18 + deltaScoreLong * 0.15 + rsiScoreLong * 0.12 + stochScoreLong * 0.12 + adxScore * 0.10 + volScore * 0.10
    shortScoreRaw = trendScoreShort * 0.23 + macdScoreShort * 0.18 + deltaScoreShort * 0.15 + rsiScoreShort * 0.12 + stochScoreShort * 0.12 + adxScore * 0.10 + volScore * 0.10

    longScore  = math.round(math.min(100, math.max(0, longScoreRaw  * volMultiplier)))
    shortScore = math.round(math.min(100, math.max(0, shortScoreRaw * volMultiplier)))

    totalRaw = longScore + shortScore
    longPct  := totalRaw > 0 ? math.round(longScore / totalRaw * 100) : 50
    shortPct := 100 - longPct

offset = barShift * 5

var box   longProjBody      = na
var line  longProjWickUp    = na
var line  longProjWickDown  = na
var label longProjLabel     = na
var box   shortProjBody     = na
var line  shortProjWickUp   = na
var line  shortProjWickDown = na
var label shortProjLabel    = na
var box   projZoneBox       = na
var line  projDashLine      = na

if barstate.islast
    box.delete(projZoneBox)
    line.delete(projDashLine)
    box.delete(longProjBody)
    line.delete(longProjWickUp)
    line.delete(longProjWickDown)
    label.delete(longProjLabel)
    box.delete(shortProjBody)
    line.delete(shortProjWickUp)
    line.delete(shortProjWickDown)
    label.delete(shortProjLabel)

    if show_ncp
        zoneTop    = ta.highest(high, 30) + atr_ncp * 1.5
        zoneBottom = ta.lowest(low, 30)   - atr_ncp * 1.5

        projDashLine := line.new(bar_index + offset - 2, zoneTop, bar_index + offset - 2, zoneBottom, color=colGray, width=1, style=line.style_dashed)
        projZoneBox  := box.new(bar_index + offset - 2, zoneTop, bar_index + offset + 8, zoneBottom, bgcolor=color.new(colFTBackground, 70), border_color=color.new(colFTBackground, 50), border_width=1)

        volMult     = volRegime == "HIGH" ? 1.5 : volRegime == "LOW" ? 0.7 : 1.0
        maxHeight   = atr_ncp * 2 * volMult
        longHeight  = maxHeight * (longPct  / 100)
        shortHeight = maxHeight * (shortPct / 100)
        wickLen     = avgBody * 0.4

        longStart        = bar_index + offset
        longProjBody     := box.new(longStart, close + longHeight, longStart + 1, close, bgcolor=colLong, border_color=colLong, border_width=1)
        longProjWickUp   := line.new(longStart, close + longHeight, longStart, close + longHeight + wickLen, color=colLong, width=2)
        longProjWickDown := line.new(longStart, close, longStart, close - wickLen, color=colLong, width=2)
        longProjLabel    := label.new(longStart, close + longHeight + wickLen + atr_ncp * 0.15, str.tostring(longPct) + "%", style=label.style_label_down, color=colLong, textcolor=colText, size=size.tiny)

        shortStart        = bar_index + offset + 3
        shortProjBody     := box.new(shortStart, close, shortStart + 1, close - shortHeight, bgcolor=colShort, border_color=colShort, border_width=1)
        shortProjWickUp   := line.new(shortStart, close, shortStart, close + wickLen, color=colShort, width=2)
        shortProjWickDown := line.new(shortStart, close - shortHeight, shortStart, close - shortHeight - wickLen, color=colShort, width=2)
        shortProjLabel    := label.new(shortStart, close - shortHeight - wickLen - atr_ncp * 0.15, str.tostring(shortPct) + "%", style=label.style_label_up, color=colShort, textcolor=colText, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// 06. GOLD FLIP
// ═══════════════════════════════════════════════════════════════════════════════
grp_gflip      = "═══════════ 06. Gold Flip ═══════════"

atr_period = input.int(10, "Smoothing Period", group=grp_gflip)
atr_mult   = input.float(2.0, "Flip Sensitivity (ATR Mult)", group=grp_gflip, step=0.1)

color_bull = input.color(color.lime, "Bullish Line Color", group=grp_gflip)
color_bear = input.color(color.red,  "Bearish Line Color", group=grp_gflip)

[trend_line, direction] = ta.supertrend(atr_mult, atr_period)

bool is_flip_buy  = direction < 0 and direction[1] > 0
bool is_flip_sell = direction > 0 and direction[1] < 0

line_color = direction < 0 ? color_bull : color_bear
plot(show_gflip ? trend_line : na, color=line_color, linewidth=3, title="Flip Line / Stop Loss")

plotshape(show_gflip and is_flip_buy,  title="FLIP BUY",  location=location.belowbar, color=color_bull, style=shape.labelup,   text="B", textcolor=color.black, size=size.tiny)
plotshape(show_gflip and is_flip_sell, title="FLIP SELL", location=location.abovebar, color=color_bear, style=shape.labeldown, text="S", textcolor=color.white, size=size.tiny)

// ═══════════════════════════════════════════════════════════════════════════════
// 07. WAVETREND
// ═══════════════════════════════════════════════════════════════════════════════
grp_wt = "═══════════ 07. WaveTrend ═══════════"

// ── Core WT Inputs ──────────────────────────────────────────────────────────
n1_wt       = input.int(title="Channel Length",      defval=10, group=grp_wt)
n2_wt       = input.int(title="Average Length",       defval=21, group=grp_wt)
obLevel1_wt = input.int(title="Over Bought Level 1", defval=60, group=grp_wt)
obLevel2_wt = input.int(title="Over Bought Level 2", defval=53, group=grp_wt)
osLevel1_wt = input.int(title="Over Sold Level 1",   defval=-60, group=grp_wt)
osLevel2_wt = input.int(title="Over Sold Level 2",   defval=-53, group=grp_wt)

useLag_wt   = input.bool(title="Apply Laguerre Smoothing", defval=true, group=grp_wt)
gamma_wt    = input.float(title="Laguerre Gamma",          defval=0.02, group=grp_wt)

// ── Positioning Inputs ──────────────────────────────────────────────────────
grp_wt_pos = "07. WaveTrend - Positioning"
gapPct_wt     = input.float(title="Gap Above Candles %",  defval=5.0,  minval=0.0, maxval=50.0, group=grp_wt_pos, tooltip="Vertical gap between highest candle and the bottom of the WT band, as % of price range")
bandPct_wt    = input.float(title="Band Height %",         defval=10.0, minval=5.0, maxval=80.0, group=grp_wt_pos, tooltip="Height of the WT indicator band as % of price range")
heightMul_wt  = input.float(title="Vertical Offset Multiplier (1x-10x)", defval=1.0, minval=1.0, maxval=10.0, step=0.5, group=grp_wt_pos, tooltip="1x = default position, higher = push indicator further up, lower = closer to candles")
numBars_wt    = input.int(title="Number of Bars to Show",  defval=500, minval=50,  maxval=5000, group=grp_wt_pos)

// ── Level Style Inputs ──────────────────────────────────────────────────────
grp_wt_levels = "07. WaveTrend - Level Styles"
obL1Color_wt  = input.color(title="Overbought Level 1 Color", defval=color.rgb(17, 16, 16), group=grp_wt_levels)
obL2Color_wt  = input.color(title="Overbought Level 2 Color", defval=#FF8A80, group=grp_wt_levels)
osL1Color_wt  = input.color(title="Oversold Level 1 Color",   defval=#0c0c0c, group=grp_wt_levels)
osL2Color_wt  = input.color(title="Oversold Level 2 Color",   defval=#69F0AE, group=grp_wt_levels)
midColor_wt   = input.color(title="Mid / Zero Line Color",    defval=#FFFFFF, group=grp_wt_levels)
obL1Width_wt  = input.int(title="Overbought Level 1 Width", defval=2, minval=1, maxval=5, group=grp_wt_levels)
obL2Width_wt  = input.int(title="Overbought Level 2 Width", defval=1, minval=1, maxval=5, group=grp_wt_levels)
osL1Width_wt  = input.int(title="Oversold Level 1 Width",   defval=2, minval=1, maxval=5, group=grp_wt_levels)
osL2Width_wt  = input.int(title="Oversold Level 2 Width",   defval=1, minval=1, maxval=5, group=grp_wt_levels)
midWidth_wt   = input.int(title="Mid / Zero Line Width",     defval=1, minval=1, maxval=5, group=grp_wt_levels)

// ── Divergence Inputs ───────────────────────────────────────────────────────
grp_wt_div = "07. WaveTrend - Divergence"
showDiv_wt       = input.bool(true,  "Show Divergences", group=grp_wt_div)
src_wt           = input.string(title="Source", defval="Wave Trend", options=["Wave Trend", "Signal", "Histogram"], group=grp_wt_div)
lbR_wt           = input.int(title="Pivot Lookback Right", defval=5, group=grp_wt_div)
lbL_wt           = input.int(title="Pivot Lookback Left",  defval=5, group=grp_wt_div)
rangeUpper_wt    = input.int(title="Max of Lookback Range", defval=60, group=grp_wt_div)
rangeLower_wt    = input.int(title="Min of Lookback Range", defval=5, group=grp_wt_div)
plotBull_wt      = input.bool(title="Plot Bullish",          defval=true, group=grp_wt_div)
plotHiddenBull_wt= input.bool(title="Plot Hidden Bullish",   defval=false, group=grp_wt_div)
plotBear_wt      = input.bool(title="Plot Bearish",          defval=true, group=grp_wt_div)
plotHiddenBear_wt= input.bool(title="Plot Hidden Bearish",   defval=false, group=grp_wt_div)

// ── Only show last N bars ───────────────────────────────────────────────────
showBars_wt = bar_index >= (last_bar_index - numBars_wt + 1)

// ── Laguerre Smoothing ──────────────────────────────────────────────────────
lag_wt(g_wt, p_wt) =>
    L0_wt = 0.0
    L0_wt := (1 - g_wt) * p_wt + g_wt * nz(L0_wt[1])
    L1_wt = 0.0
    L1_wt := -g_wt * L0_wt + nz(L0_wt[1]) + g_wt * nz(L1_wt[1])
    L2_wt = 0.0
    L2_wt := -g_wt * L1_wt + nz(L1_wt[1]) + g_wt * nz(L2_wt[1])
    L3_wt = 0.0
    L3_wt := -g_wt * L2_wt + nz(L2_wt[1]) + g_wt * nz(L3_wt[1])
    (L0_wt + 2 * L1_wt + 2 * L2_wt + L3_wt) / 6

// ── WaveTrend Calculation ───────────────────────────────────────────────────
ap_wt    = hlc3
esa_wt   = ta.ema(ap_wt, n1_wt)
apesa_wt = math.abs(ap_wt - esa_wt)
d_wt     = ta.ema(apesa_wt, n1_wt)
ci_wt    = (ap_wt - esa_wt) / (0.015 * d_wt)
tci_wt   = ta.ema(ci_wt, n2_wt)

output_wt = lag_wt(gamma_wt, tci_wt)
wt1_wt    = useLag_wt ? output_wt : tci_wt
wt2_wt    = ta.sma(wt1_wt, 4)
wt3_wt    = wt1_wt - wt2_wt  // kept for divergence only

// ── Vertical Positioning — Scale WT Above Candles ──────────────────────────
lookback_wt   = math.min(numBars_wt, bar_index + 1)
highestHi_wt  = ta.highest(high, lookback_wt)
lowestLo_wt   = ta.lowest(low,  lookback_wt)
priceRange_wt = highestHi_wt - lowestLo_wt

gapPx_wt      = priceRange_wt * (gapPct_wt  / 100.0)
bandHeight_wt = priceRange_wt * (bandPct_wt / 100.0)

bottomOfBand_wt = highestHi_wt + gapPx_wt * heightMul_wt

// Map WT range [-60, +60] into price-scale band
scaleWT_wt(wtVal_wt) =>
    bottomOfBand_wt + (wtVal_wt + 60.0) / 120.0 * bandHeight_wt

displayWt1_wt = scaleWT_wt(wt1_wt)
displayWt2_wt = scaleWT_wt(wt2_wt)

// ── Main Plots (WT1, WT2 only — no histogram) ───────────────────────────
plot(show_wt and showBars_wt ? displayWt1_wt : na, title="WT1", color=#2962FF)
plot(show_wt and showBars_wt ? displayWt2_wt : na, title="WT2", color=color.orange)

// ── Crossover Signals ───────────────────────────────────────────────────────
signal1_wt = ta.crossover(wt1_wt, wt2_wt)   and wt1_wt < osLevel2_wt
signal2_wt = ta.crossunder(wt1_wt, wt2_wt)  and wt1_wt > obLevel2_wt

plotshape(show_wt and signal1_wt and showBars_wt ? displayWt1_wt : na, style=shape.xcross, location=location.absolute, size=size.small, color=color.lime,  title="Green cross")
plotshape(show_wt and signal2_wt and showBars_wt ? displayWt1_wt : na, style=shape.xcross, location=location.absolute, size=size.small, color=color.red,   title="Red cross")

// ── Overbought / Oversold Level Lines ───────────────────────────────────────
plot(show_wt and showBars_wt ? scaleWT_wt(obLevel1_wt) : na, color=color.new(obL1Color_wt, 0), linewidth=obL1Width_wt, style=plot.style_linebr, title="OB Level 1")
plot(show_wt and showBars_wt ? scaleWT_wt(obLevel2_wt) : na, color=color.new(obL2Color_wt, 30), linewidth=obL2Width_wt, style=plot.style_linebr, title="OB Level 2")
plot(show_wt and showBars_wt ? scaleWT_wt(osLevel1_wt) : na, color=color.new(osL1Color_wt, 0), linewidth=osL1Width_wt, style=plot.style_linebr, title="OS Level 1")
plot(show_wt and showBars_wt ? scaleWT_wt(osLevel2_wt) : na, color=color.new(osL2Color_wt, 30), linewidth=osL2Width_wt, style=plot.style_linebr, title="OS Level 2")
plot(show_wt and showBars_wt ? scaleWT_wt(0)           : na, color=color.new(midColor_wt,  40), linewidth=midWidth_wt,  style=plot.style_linebr, title="Zero Line")

// ── Divergence Detection ────────────────────────────────────────────────────
bearColor_wt       = color.red
bullColor_wt       = color.green
hiddenBullColor_wt = color.new(color.green, 80)
hiddenBearColor_wt = color.new(color.red,   80)
textColor_wt       = color.white
noneColor_wt       = color.new(color.white, 100)

osc_wt = showDiv_wt ? src_wt == "Wave Trend" ? wt1_wt : src_wt == "Signal" ? wt2_wt : src_wt == "Histogram" ? wt3_wt : wt1_wt : na

plFound_wt = na(ta.pivotlow(osc_wt, lbL_wt, lbR_wt))  ? false : true
phFound_wt = na(ta.pivothigh(osc_wt, lbL_wt, lbR_wt)) ? false : true

_inRange_wt(cond_wt) =>
    bars_wt = ta.barssince(cond_wt == true)
    rangeLower_wt <= bars_wt and bars_wt <= rangeUpper_wt

// ── Regular Bullish Divergence ──────────────────────────────────────────────
oscHL_wt = osc_wt[lbR_wt] > ta.valuewhen(plFound_wt, osc_wt[lbR_wt], 1) and _inRange_wt(plFound_wt[1])
priceLL_wt = low[lbR_wt] < ta.valuewhen(plFound_wt, low[lbR_wt], 1)
bullCond_wt = plotBull_wt and priceLL_wt and oscHL_wt and plFound_wt

plot(show_wt and showBars_wt and plFound_wt ? scaleWT_wt(osc_wt[lbR_wt]) : na, offset=-lbR_wt, title="Regular Bullish",   linewidth=2, color=bullCond_wt ? bullColor_wt : noneColor_wt)
plotshape(show_wt and bullCond_wt and showBars_wt ? scaleWT_wt(osc_wt[lbR_wt]) : na, offset=-lbR_wt, title="Regular Bullish Label", text=" Bull ", style=shape.labelup, location=location.absolute, color=bullColor_wt, textcolor=textColor_wt)

// ── Hidden Bullish Divergence ───────────────────────────────────────────────
oscLL_wt = osc_wt[lbR_wt] < ta.valuewhen(plFound_wt, osc_wt[lbR_wt], 1) and _inRange_wt(plFound_wt[1])
priceHL_wt = low[lbR_wt] > ta.valuewhen(plFound_wt, low[lbR_wt], 1)
hiddenBullCond_wt = plotHiddenBull_wt and priceHL_wt and oscLL_wt and plFound_wt

plot(show_wt and showBars_wt and plFound_wt ? scaleWT_wt(osc_wt[lbR_wt]) : na, offset=-lbR_wt, title="Hidden Bullish", linewidth=2, color=hiddenBullCond_wt ? hiddenBullColor_wt : noneColor_wt)
plotshape(show_wt and hiddenBullCond_wt and showBars_wt ? scaleWT_wt(osc_wt[lbR_wt]) : na, offset=-lbR_wt, title="Hidden Bullish Label", text=" H Bull ", style=shape.labelup, location=location.absolute, color=bullColor_wt, textcolor=textColor_wt)

// ── Regular Bearish Divergence ──────────────────────────────────────────────
oscLH_wt = osc_wt[lbR_wt] < ta.valuewhen(phFound_wt, osc_wt[lbR_wt], 1) and _inRange_wt(phFound_wt[1])
priceHH_wt = high[lbR_wt] > ta.valuewhen(phFound_wt, high[lbR_wt], 1)
bearCond_wt = plotBear_wt and priceHH_wt and oscLH_wt and phFound_wt

plot(show_wt and showBars_wt and phFound_wt ? scaleWT_wt(osc_wt[lbR_wt]) : na, offset=-lbR_wt, title="Regular Bearish", linewidth=2, color=bearCond_wt ? bearColor_wt : noneColor_wt)
plotshape(show_wt and bearCond_wt and showBars_wt ? scaleWT_wt(osc_wt[lbR_wt]) : na, offset=-lbR_wt, title="Regular Bearish Label", text=" Bear ", style=shape.labeldown, location=location.absolute, color=bearColor_wt, textcolor=textColor_wt)

// ── Hidden Bearish Divergence ───────────────────────────────────────────────
oscHH_wt = osc_wt[lbR_wt] > ta.valuewhen(phFound_wt, osc_wt[lbR_wt], 1) and _inRange_wt(phFound_wt[1])
priceLH_wt = high[lbR_wt] < ta.valuewhen(phFound_wt, high[lbR_wt], 1)
hiddenBearCond_wt = plotHiddenBear_wt and priceLH_wt and oscHH_wt and phFound_wt

plot(show_wt and showBars_wt and phFound_wt ? scaleWT_wt(osc_wt[lbR_wt]) : na, offset=-lbR_wt, title="Hidden Bearish", linewidth=2, color=hiddenBearCond_wt ? hiddenBearColor_wt : noneColor_wt)
plotshape(show_wt and hiddenBearCond_wt and showBars_wt ? scaleWT_wt(osc_wt[lbR_wt]) : na, offset=-lbR_wt, title="Hidden Bearish Label", text=" H Bear ", style=shape.labeldown, location=location.absolute, color=bearColor_wt, textcolor=textColor_wt)



// ═══════════════════════════════════════════════════════════════════════════════
// SESSION BOX
// ═══════════════════════════════════════════════════════════════════════════════
GRP_BOX = '═══ Session Box ═══'

show_sydney = input(true, '', inline = 'sydney', group = GRP_BOX)
sydney_txt  = input('Sydney', '', inline = 'sydney', group = GRP_BOX)
sydney_ses  = input.session('2200-0700', '', inline = 'sydney', group = GRP_BOX)
sydney_css  = input.color(color.rgb(0, 0, 0), '', inline = 'sydney', group = GRP_BOX)

show_tokyo  = input(true, '', inline = 'tokyo', group = GRP_BOX)
tokyo_txt   = input('Tokyo', '', inline = 'tokyo', group = GRP_BOX)
tokyo_ses   = input.session('0000-0900', '', inline = 'tokyo', group = GRP_BOX)
tokyo_css   = input.color(#e91e63, '', inline = 'tokyo', group = GRP_BOX)

show_london = input(true, '', inline = 'london', group = GRP_BOX)
london_txt  = input('London', '', inline = 'london', group = GRP_BOX)
london_ses  = input.session('0700-1600', '', inline = 'london', group = GRP_BOX)
london_css  = input.color(#2157f3, '', inline = 'london', group = GRP_BOX)

show_ny     = input(true, '', inline = 'ny', group = GRP_BOX)
ny_txt      = input('New York', '', inline = 'ny', group = GRP_BOX)
ny_ses      = input.session('1300-2200', '', inline = 'ny', group = GRP_BOX)
ny_css      = input.color(#ff00aa, '', inline = 'ny', group = GRP_BOX)

tz_incr      = input.int(0, 'UTC Offset (+/-)', group = GRP_BOX)
use_exchange = input(false, 'Use Exchange Timezone', group = GRP_BOX)
bg_transp    = input.float(85, 'Box Transparency', group = GRP_BOX)

// ═══════════════════════════════════════════════════════════════════════════════
// SHIFTED SESSION CANDLES
// ═══════════════════════════════════════════════════════════════════════════════
GRP_CDL = '═══ Shifted Candles ═══'

show_candles    = input.bool(false, 'Show Shifted Candles', group = GRP_CDL)
override_colors = input.bool(false, 'Override to Green/Red', group = GRP_CDL)
bull_clr        = input.color(color.green, 'Bull', inline = 'c', group = GRP_CDL)
bear_clr        = input.color(color.red, ' | Bear', inline = 'c', group = GRP_CDL)
candle_w        = input.int(2, 'Width', minval = 1, maxval = 10, inline = 'w', group = GRP_CDL)
candle_sp       = input.int(3, ' | Spacing', minval = 1, maxval = 20, inline = 'w', group = GRP_CDL)
chart_offset    = input.int(30, 'Offset from Chart', minval = 10, maxval = 100, group = GRP_CDL)
max_hist        = input.int(6, 'Max Candles', minval = 1, maxval = 30, group = GRP_CDL)

// ═══════════════════════════════════════════════════════════════════════════════
// TIMEZONE & SESSION DETECTION (LuxAlgo method)
// ═══════════════════════════════════════════════════════════════════════════════

tf = timeframe.period

var tz = use_exchange ? syminfo.timezone : str.format('UTC{0}{1}', tz_incr >= 0 ? '+' : '-', math.abs(tz_incr))

is_sydney = show_sydney ? math.sign(nz(time(tf, sydney_ses, tz))) : 0
is_tokyo  = show_tokyo  ? math.sign(nz(time(tf, tokyo_ses,  tz))) : 0
is_london = show_london ? math.sign(nz(time(tf, london_ses, tz))) : 0
is_ny     = show_ny     ? math.sign(nz(time(tf, ny_ses,     tz))) : 0

// ═══════════════════════════════════════════════════════════════════════════════
// PER-SESSION STATE (UDT) — separate instance per session, no shared variable
// ═══════════════════════════════════════════════════════════════════════════════

type Ses
    float o
    float h
    float l
    float c
    box   bx
    label lb
    bool  active
    string name
    color clr

var Ses sSyd = Ses.new(0.0, 0.0, 0.0, 0.0, na, na, false, sydney_txt, sydney_css)
var Ses sTok = Ses.new(0.0, 0.0, 0.0, 0.0, na, na, false, tokyo_txt, tokyo_css)
var Ses sLon = Ses.new(0.0, 0.0, 0.0, 0.0, na, na, false, london_txt, london_css)
var Ses sNy  = Ses.new(0.0, 0.0, 0.0, 0.0, na, na, false, ny_txt, ny_css)

// ═══════════════════════════════════════════════════════════════════════════════
// HISTORY ARRAYS (for shifted candles)
// ═══════════════════════════════════════════════════════════════════════════════

var array<string> hName = array.new<string>()
var array<float> hO    = array.new<float>()
var array<float> hH    = array.new<float>()
var array<float> hL    = array.new<float>()
var array<float> hC    = array.new<float>()
var array<color> hClr  = array.new<color>()

// Drawn candle objects (for cleanup on redraw)
var array<line>  cLines  = array.new<line>()
var array<box>   cBoxes  = array.new<box>()
var array<label> cLabels = array.new<label>()

// ═══════════════════════════════════════════════════════════════════════════════
// SESSION BOX FUNCTION — reusable, operates on per-session state
// ═══════════════════════════════════════════════════════════════════════════════

fSesBox(Ses s, bool show, float isSes, color clr, string name) =>
    if show
        // ── Session START ──
        if isSes > isSes[1]
            s.o      := open
            s.h      := high
            s.l      := low
            s.c      := close
            s.active := true
            s.name   := name
            s.clr    := clr
            s.bx     := box.new(bar_index, s.h, bar_index, s.l
                 , bgcolor      = color.new(clr, bg_transp)
                 , border_color = na)
            s.lb     := label.new(bar_index, s.h, name
                 , xloc         = xloc.bar_index
                 , yloc         = yloc.price
                 , color        = color.new(color.black, 100)
                 , textcolor    = clr
                 , style        = label.style_label_down
                 , size         = size.small)

        // ── Session CONTINUE ──
        if isSes != 0 and isSes == isSes[1]
            s.h := math.max(high, s.h)
            s.l := math.min(low, s.l)
            s.c := close
            box.set_top(s.bx, s.h)
            box.set_rightbottom(s.bx, bar_index, s.l)
            label.set_y(s.lb, s.h)

        // ── Session END → store OHLC for candle ──
        if isSes == 0 and isSes[1] != 0 and s.active
            s.active := false
            if array.size(hName) >= max_hist
                array.shift(hName)
                array.shift(hO)
                array.shift(hH)
                array.shift(hL)
                array.shift(hC)
                array.shift(hClr)
            array.push(hName, s.name)
            array.push(hO, s.o)
            array.push(hH, s.h)
            array.push(hL, s.l)
            array.push(hC, s.c)
            array.push(hClr, s.clr)

// ── Process all sessions ──────────────────────────────────────────────────────
fSesBox(sSyd, show_sydney, is_sydney, sydney_css, sydney_txt)
fSesBox(sTok, show_tokyo,  is_tokyo,  tokyo_css,  tokyo_txt)
fSesBox(sLon, show_london, is_london, london_css, london_txt)
fSesBox(sNy,  show_ny,     is_ny,     ny_css,     ny_txt)

// ═══════════════════════════════════════════════════════════════════════════════
// SHIFTED CANDLE DRAWING (last bar only for performance)
// ═══════════════════════════════════════════════════════════════════════════════

fCandleClr(color sesClr, bool isBull) =>
    override_colors ? (isBull ? bull_clr : bear_clr) : sesClr

fDrawCandle(int x, float o, float h, float l, float c, color sesClr) =>
    isBull  = c >= o
    bodyTop = isBull ? c : o
    bodyBot = isBull ? o : c
    clr     = fCandleClr(sesClr, isBull)
    // Wick
    array.push(cLines, line.new(x, h, x, l, color = clr, width = 1))
    // Body
    array.push(cBoxes, box.new(x - candle_w / 2, bodyTop, x + candle_w / 2, bodyBot, border_color = clr, bgcolor = color.new(clr, 0)))
    // Bull/Bear triangle
    triClr = override_colors ? fCandleClr(sesClr, false) : (isBull ? color.green : color.red)
    triY   = l - math.abs(h - l) * 0.05
    array.push(cLabels, label.new(x, triY, isBull ? '▲' : '▼', xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.black, 100), textcolor = triClr, size = size.small, style = label.style_label_up))

if show_candles and barstate.islast
    // Clear previous candle objects
    while array.size(cLines) > 0
        line.delete(array.pop(cLines))
    while array.size(cBoxes) > 0
        box.delete(array.pop(cBoxes))
    while array.size(cLabels) > 0
        label.delete(array.pop(cLabels))

    n = array.size(hName)

    // Historical candles (completed sessions)
    if n > 0
        for i = 0 to n - 1
            x = bar_index + chart_offset + i * candle_sp
            fDrawCandle(x, array.get(hO, i), array.get(hH, i), array.get(hL, i), array.get(hC, i), array.get(hClr, i))

    // Live candle(s) — sessions currently active
    liveIdx = 0
    if sSyd.active
        x = bar_index + chart_offset + (n + liveIdx) * candle_sp
        fDrawCandle(x, sSyd.o, sSyd.h, sSyd.l, sSyd.c, sSyd.clr)
        liveIdx += 1
    if sTok.active
        x = bar_index + chart_offset + (n + liveIdx) * candle_sp
        fDrawCandle(x, sTok.o, sTok.h, sTok.l, sTok.c, sTok.clr)
        liveIdx += 1
    if sLon.active
        x = bar_index + chart_offset + (n + liveIdx) * candle_sp
        fDrawCandle(x, sLon.o, sLon.h, sLon.l, sLon.c, sLon.clr)
        liveIdx += 1
    if sNy.active
        x = bar_index + chart_offset + (n + liveIdx) * candle_sp
        fDrawCandle(x, sNy.o, sNy.h, sNy.l, sNy.c, sNy.clr)
// ═══════════════════════════════════════════════════════════════════════════════
// 09. LIQUIDITY SENTIMENT PROFILE  (© LuxAlgo — CC BY-NC-SA 4.0)
// ═══════════════════════════════════════════════════════════════════════════════
// Integrated from: "Liquidity Sentiment Profile (Auto-Anchored) [LuxAlgo]"
// Migrated v5 → v6, all variables namespaced with "lsp" prefix

lspGRP = '═══════════ 09. Liquidity Sentiment Profile ═══════════'

lspTfTP  = 'The indicator resolution is set by the input of the Anchor Period. If the Anchor Period is set to AUTO, then the increased resolution is determined by the following algorithm:\n\n' +
          ' - for intraday resolutions up to 4 Hour, DAY (1D) is used\n - for intraday resolutions equal to 4 Hour, WEEK (1W) is used\n - for daily resolutions MONTH is used (1M)\n - for weekly resolution, 3-MONTH (3M) is used\n - for monthly resolution, 12-MONTH (12M) is used\n\n' +
          'If the Anchor Period is set to Fixed Range then the period is defined in the \'Fixed Period\' option\n\n' +
          'If the Anchor Period is set to Swing High or Swing Low then the length required to calculate Swing Levels is defined in the \'Swing Detection Length\' option\n\n' +
          'Note : Difference between Session and Day\n - Day will take into account extended hours (if present on the chart), whereas\n - Session will assume only regular trading hours. Session is default value for AUTO Anchor Period'
lspTfIN  = input.string('Fixed Range', 'Anchor Period', options=['Auto', 'Fixed Range', 'Swing High', 'Swing Low', 'Session', 'Day', 'Week', 'Month', 'Quarter', 'Year'], group = lspGRP, tooltip = lspTfTP)
lspTfOT  = lspTfIN == 'Session' or lspTfIN == 'Day' ? 'D' : lspTfIN == 'Week' ? 'W' : lspTfIN == 'Month' ? 'M' : lspTfIN == 'Quarter' ? '3M' : lspTfIN == 'Year' ? '12M' : timeframe.isintraday and timeframe.period != '240' ? 'D' : timeframe.period == '240' ? 'W' : timeframe.isdaily ? 'M' : timeframe.isweekly ? '3M' : '12M'

lspDrpTT = 'Applicable if the Anchor Period is set to \'Fixed Range\' then the period of the profile is defined with this option\n\npossible min value [10]'
lspDrpLN = input.int(360, 'Fixed Period', minval = 10, group = lspGRP, tooltip = lspDrpTT)

lspPpTT  = 'Applicable if the Anchor Period is set to \'Swing High\' or \'Swing Low\' then the length required to detect the Swing Levels is defined with this option\n\npossible min value [1]'
lspPpLen = input.int(47, "Swing Detection Length", minval = 1, group = lspGRP, tooltip = lspPpTT)

// ── Liquidity Profile inputs ──
lspLpGR  = '09. LSP - Liquidity Profile'
lspVpTP  = 'In trading, liquidity refers to the availability of orders at specific price points in the market, allowing transactions to occur smoothly, and the profile displays total trading activity (common interest, both buying and selling trading activity) over a specified time period at specific price levels\n\n' +
          ' - high volume node rows : high trading activity price levels - usually represents consolidation levels (value areas)\n' +
          ' - average volume node rows : average trading activity price levels\n' +
          ' - low volume node rows : low trading activity price levels - usually represents supply & demand levels or liquidity levels\n\n' +
          'row lengths, indicates the amount of the traded activity'
lspVpSH  = input.bool(true, 'Liquidity Profile', group = lspLpGR, tooltip = lspVpTP)
lspVpHVC = input.color(color.new(#ff9800, 11), 'High Traded Nodes', inline='LVP1', group = lspLpGR)
lspVpHVT = input.int(53, 'Threshold %' , minval = 47, maxval = 99 , step = 1, inline='LVP1', group = lspLpGR, tooltip = 'possible values [47-99]') / 100
lspVpAVC = input.color(color.new(#5d606b, 51), 'Average Traded Nodes', inline='LVP3' , group = lspLpGR)
lspVpLVC = input.color(color.new(#2962ff, 11), 'Low Traded Nodes', inline='LVP2', group = lspLpGR)
lspVpLVT = input.int(27, 'Threshold %' , minval = 10, maxval = 47 , step = 1, inline='LVP2', group = lspLpGR, tooltip = 'possible values [10-47]') / 100

// ── Sentiment Profile inputs ──
lspSpGR  = '09. LSP - Sentiment Profile'
lspSpTP  = 'displays the sentiment, the dominat party over a specified time period at the specific price levels\n\n' +
          ' - bullish node rows : buying trading activity is higher\n'  +
          ' - bearish node rows : selling trading activity is higher\n\n' +
          'row lengths, indicates the strength of the buyers/sellers at the specific price levels'
lspSpSH  = input.bool(true, 'Sentiment Profile', group = lspSpGR, tooltip = lspSpTP)
lspSpBLC = input.color(color.new(#26a69a, 73), 'Bullish Nodes', inline='LSP', group = lspSpGR)
lspSpBRC = input.color(color.new(#ef5350, 73), 'Bearish Nodes', inline='LSP', group = lspSpGR)

// ── Buy/Sell Liquidity inputs ──
lspSdGR  = '09. LSP - Buyside & Sellside Liquidity'
lspSdTP  = 'Typically refer to the resting orders in the market, such as limit orders, stop loss orders, and stop limit orders, which can be absorbed or targeted by banks or financial institutions. Those levels are also reffered as supply & demand levels in the market'
lspSdSH  = input.bool(true, 'Buyside & Sellside Liquidity Zones', group = lspSdGR, tooltip = lspSdTP)
lspSdTH  = input.int(13, 'Threshold %' , minval = 0, maxval = 31, group = lspSdGR, tooltip = 'possible threshold values [0-31]\n\nhigher values return wider areas') / 100
lspSdCR  = input.color(color.new(#0094FF, 81), 'Buyside Liquidity Nodes', inline='Llow2', group = lspSdGR)
lspSdCS  = input.color(color.new(#ec1313, 81), 'Sellside Liquidity Nodes', inline='Llow2', group = lspSdGR)

// ── Other LSP settings ──
lspOthGR = '09. LSP - Other Settings'
lspPcTP  = 'displays the changes of the price levels with the highest traded activity'
lspRpPC  = input.bool(false, 'Level of Significance', inline='LPoC', group = lspOthGR, tooltip = lspPcTP)
lspRpPCC = input.color(color.new(#ff0000, 1), '', inline='LPoC', group = lspOthGR)
lspRpPCW = input.int(2, '', inline='LPoC', group = lspOthGR)

lspRpPL  = input.bool(false, 'Price Levels, Color', inline='LBBe', group = lspOthGR)
lspRpPLC = input.color(color.new(#00bcd4, 1), '', inline='LBBe', group = lspOthGR)
lspRpLS  = input.string('Small', "Size", options=['Tiny', 'Small', 'Normal'], inline='LBBe', group = lspOthGR)
lspRpS   = switch lspRpLS
    'Tiny'   => size.tiny
    'Small'  => size.small
    'Normal' => size.normal

lspRpNR  = input.int(123, 'Number of Rows' , minval = 10, maxval = 155 ,step = 5, group = lspOthGR, tooltip = 'possible values [10-155]')
lspRpW   = input.int(10, 'Profile Width %', minval = 10, maxval = 50, group = lspOthGR, tooltip = 'possible values [10-50]') / 100
lspDrpHO = input.int(0, 'Horizontal Offset', minval = 0, maxval = 100 ,group = lspOthGR, tooltip = 'plotting by default will be performed on rightmost, where\nhorizontal offset option is for further adjustments\npossible values [0-100]')

lspRpBG  = input.bool(true, 'Range Background Fill', inline ='LBG', group = lspOthGR)
lspRpBGC = input.color(color.new(#00bcd4, 95), '', inline ='LBG', group = lspOthGR)

// ── LSP User Defined Types ─────────────────────────────────────────────────

// @type        bar properties with their values
// @field o     (float) open price of the bar
// @field h     (float) high price of the bar
// @field l     (float) low price of the bar
// @field c     (float) close price of the bar
// @field v     (float) volume of the bar
// @field i     (int) index of the bar

type lspBar
    float o = open
    float h = high
    float l = low
    float c = close
    float v = volume
    int   i = bar_index

// @type        store pivot high/low and index data
// @field x     (int)    last pivot bar index
// @field h     (float)  last pivot high
// @field h1    (float)  previous pivot high
// @field l     (float)  last pivot low
// @field l1    (float)  previous pivot low

type lspPivotPoint
    int    x
    float  h
    float  h1
    float  l
    float  l1

// ── LSP Variables ─────────────────────────────────────────────────────────

lspB   = lspBar.new()

var lspPivotPoint lspPp = lspPivotPoint.new()

lspBull = lspB.c > lspB.o
max_bars_back(lspBull, 5000)

lspNzV = nz(lspB.v)

lspVST = array.new_float(lspRpNR + 1, 0.0)
lspVSB = array.new_float(lspRpNR + 1, 0.0)
lspVSD = array.new_float(lspRpNR + 1, 0.0)

var lspDRP = array.new_box()
var lspDPC = array.new_line()

var int   lspX2   = 0
var float lspPir  = na
var int   lspPpX  = na
var float lspPpY  = na

// ── LSP Function ──────────────────────────────────────────────────────────

// @function        creates new label object and updates existing label objects
// @param           details in Pine Script language reference manual
// @returns         none, updated visual objects (labels)

f_lspDrawLabelX(_x, _y, _text, _xloc, _yloc, _color, _style, _textcolor, _size, _textalign, _tooltip) =>
    var lb = label.new(_x, _y, _text, _xloc, _yloc, _color, _style, _textcolor, _size, _textalign, _tooltip)
    lb.set_xy(_x, _y)
    lb.set_text(_text)
    lb.set_tooltip(_tooltip)
    lb.set_textcolor(_textcolor)

// ── LSP Calculations ──────────────────────────────────────────────────────

lspPpH = ta.pivothigh(lspPpLen, lspPpLen)
lspPpL = ta.pivotlow (lspPpLen, lspPpLen)

if not na(lspPpH) and lspTfIN == 'Swing High'
    lspPp.h1 := lspPp.h
    lspPp.h  := lspPpH
    lspPpY   := lspPpH
    lspPpX   := lspB.i

if not na(lspPpL) and lspTfIN == 'Swing Low'
    lspPp.l1 := lspPp.l
    lspPp.l  := lspPpL
    lspPpY   := lspPpL
    lspPpX   := lspB.i

if (lspTfOT == 'D' and lspTfIN == 'Day') ? (dayofweek != dayofweek[1]) : (ta.change(time(lspTfOT)) != 0)
    lspX2 := lspB.i

lspRpLN = lspTfIN == 'Fixed Range' ? lspDrpLN : barstate.islast ? lspTfIN == 'Swing High' or lspTfIN == 'Swing Low' ? last_bar_index - lspPpX + lspPpLen : last_bar_index - lspX2 : 1
lspHST  = ta.highest(high, lspRpLN > 0 ? lspRpLN + 1 : 1)
lspLST  = ta.lowest (low , lspRpLN > 0 ? lspRpLN + 1 : 1)
lspSTP  = (lspHST - lspLST) / lspRpNR




// ── Cleanup previous LSP drawings on every tick of the last bar ──
if barstate.islast
    while lspDRP.size() > 0
        box.delete(lspDRP.shift())
    while lspDPC.size() > 0
        line.delete(lspDPC.shift())

// ── Main LSP drawing logic (runs only on last bar when conditions are met) ──
if show_lsp and barstate.islast and lspNzV > 0 and timeframe.period != lspTfOT and lspRpLN > 1 and lspSTP > 0
    // (Cleanup already performed above — proceed directly to building arrays)




    // Build volume & sentiment arrays by iterating bars
    for lspBI = lspRpLN to 0
        lspRow = 0
        for lspPriceLevel = lspLST to lspHST by lspSTP
            if (lspB[lspBI]).h >= lspPriceLevel and (lspB[lspBI]).l < lspPriceLevel + lspSTP
                lspRangeSize = ((lspB[lspBI]).h - (lspB[lspBI]).l) == 0 ? 1.0 : lspSTP / ((lspB[lspBI]).h - (lspB[lspBI]).l)
                lspVST.set(lspRow, lspVST.get(lspRow) + lspNzV[lspBI] * lspRangeSize)

                if lspBull[lspBI]
                    lspVSB.set(lspRow, lspVSB.get(lspRow) + lspNzV[lspBI] * lspRangeSize)
            lspRow += 1

        // Level of Significance (PoC) tracking
        if lspRpPC
            if lspBI == lspRpLN
                lspPir := lspLST + (lspVST.indexof(lspVST.max()) + 0.5) * lspSTP
            else
                lspDPC.push(line.new((lspB[lspBI]).i - 1, lspPir, (lspB[lspBI]).i, lspLST + (lspVST.indexof(lspVST.max()) + 0.5) * lspSTP, color = lspRpPCC, width = lspRpPCW))
                lspPir := lspLST + (lspVST.indexof(lspVST.max()) + 0.5) * lspSTP

    // Build sentiment deviation array
    for lspRow = 0 to lspRpNR - 1
        lspBbp = 2 * lspVSB.get(lspRow) - lspVST.get(lspRow)
        lspVSD.set(lspRow, lspVSD.get(lspRow) + lspBbp * (lspBbp > 0 ? 1 : -1))

    // Range background fill
    if lspRpBG
        lspDRP.push(box.new(lspB.i - lspRpLN, lspLST, lspB.i, lspHST, lspRpBGC, bgcolor = lspRpBGC))

    // Price level labels
    if lspRpPL
        f_lspDrawLabelX(lspB.i + lspDrpHO + lspRpLN * lspRpW, lspHST, str.tostring(lspHST, format.mintick), xloc.bar_index, yloc.price, color(na), label.style_label_down, lspRpPLC, lspRpS, text.align_left, 'Profile High - ' + str.tostring(lspHST, format.mintick) + '\n %' + str.tostring((lspHST - lspLST) / lspLST * 100, '#.##') + ' higher than the Profile Low\n\nNumber of bars : ' + str.tostring(lspRpLN))
        f_lspDrawLabelX(lspB.i + lspDrpHO + lspRpLN * lspRpW, lspLST, str.tostring(lspLST, format.mintick), xloc.bar_index, yloc.price, color(na), label.style_label_up  , lspRpPLC, lspRpS, text.align_left, 'Profile Low - '  + str.tostring(lspLST, format.mintick) + '\n %' + str.tostring((lspHST - lspLST) / lspHST * 100, '#.##') + ' lower than the Profile High\n\nNumber of bars : ' + str.tostring(lspRpLN))

        if lspTfIN == 'Swing High'
            lspSwH = lspPp.h > lspPp.h1 ? "HH" : lspPp.h < lspPp.h1 ? "LH" : na
            f_lspDrawLabelX((lspB[lspRpLN]).i, lspPp.h, lspSwH, xloc.bar_index, yloc.price, color(na), label.style_label_down, lspRpPLC, lspRpS, text.align_center, 'Swing High : ' + str.tostring(lspPp.h, format.mintick))

        if lspTfIN == 'Swing Low'
            lspSwL = lspPp.l < lspPp.l1 ? "LL" : lspPp.l > lspPp.l1 ? "HL" : na
            f_lspDrawLabelX((lspB[lspRpLN]).i, lspPp.l, lspSwL, xloc.bar_index, yloc.price, color(na), label.style_label_up  , lspRpPLC, lspRpS, text.align_center, 'Swing Low : '  + str.tostring(lspPp.l, format.mintick))

    // Draw profile rows: Liquidity Profile, Sentiment Profile, Buy/Sell Liquidity Zones
    for lspRow = 0 to lspRpNR - 1
        if lspVpSH
            lspSBI = lspB.i - int(lspVST.get(lspRow) / lspVST.max() * lspRpLN * lspRpW) + lspRpLN * lspRpW + lspDrpHO
            lspEBI = lspB.i + lspDrpHO + lspRpLN * lspRpW
            lspLlC = lspVST.get(lspRow) / lspVST.max() > lspVpHVT ? color.from_gradient(lspVST.get(lspRow) / lspVST.max(), lspVpHVT, 1, lspVpAVC, lspVpHVC) : color.from_gradient(lspVST.get(lspRow) / lspVST.max(), 0, lspVpLVT, lspVpLVC, lspVpAVC)
            lspDRP.push(box.new(lspSBI, lspLST + (lspRow + 0.1) * lspSTP, lspEBI, lspLST + (lspRow + 0.9) * lspSTP, color(na), bgcolor = lspLlC))

        if lspSpSH
            lspBbp = 2 * lspVSB.get(lspRow) - lspVST.get(lspRow)
            lspSBI = lspB.i + int(lspVSD.get(lspRow) / lspVSD.max() * lspRpLN * lspRpW / 2) + lspRpLN * lspRpW + lspDrpHO
            lspEBI = lspB.i + lspDrpHO + lspRpLN * lspRpW
            lspDRP.push(box.new(lspSBI, lspLST + (lspRow + 0.1) * lspSTP, lspEBI, lspLST + (lspRow + 0.9) * lspSTP, lspBbp > 0 ? lspSpBLC : lspSpBRC, bgcolor = lspBbp > 0 ? lspSpBLC : lspSpBRC))

        if lspSdSH and lspVST.get(lspRow) / lspVST.max() < lspSdTH
            lspDRP.push(box.new(lspB.i - lspRpLN, lspLST + (lspRow + 0.0) * lspSTP, lspB.i, lspLST + (lspRow + 1.0) * lspSTP, color(na), bgcolor = lspLST + (lspRow + 0.5) * lspSTP > lspLST + (lspVST.indexof(lspVST.max()) + 0.5) * lspSTP ? lspSdCR : lspSdCS))
